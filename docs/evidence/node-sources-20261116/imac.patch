+#include "shader-source.h"
+#endif
+
+typedef struct {
+    uint64_t offset;
+    uint32_t row,piece,slice,type,down,burst,units,count;
+    uint32_t expert[80],mask[80],lookup[80];
+    float gate[80];
+} Params;
+static id<MTLDevice> dev;
+static id<MTLCommandQueue> queue;
+static id<MTLComputePipelineState> gate4,gate8,quant,down;
+static id<MTLBuffer> weights[3],input,params,hidden,hq,scales,output,staging;
+static id<MTLCommandBuffer> pending;
+static unsigned max_units,loaded,layer,burst;
+static uint64_t uploaded;
+static double gpu_time;
+static id<MTLBuffer> private_buffer(size_t size) {return [dev newBufferWithLength:size options:MTLResourceStorageModePrivate];}
+int gsq_radeon_probe(void) { @autoreleasepool {
+    for(id<MTLDevice> d in MTLCopyAllDevices())
+        if(!d.hasUnifiedMemory && [d.name containsString:@"Radeon Pro 580"] &&
+           d.maxBufferLength>=fr_gsq_unit_bytes() && d.recommendedMaxWorkingSetSize>=3*fr_gsq_unit_bytes()+(512ULL<<20)) return FR_OK;
+    return FR_UNSUPPORTED;
+}}
+uint64_t gsq_radeon_device_bytes(void) {return (uint64_t)loaded*fr_gsq_unit_bytes();}
+int gsq_radeon_unload(unsigned slot) { @autoreleasepool {
+    if(slot>=3 || !weights[slot] || pending) return FR_STATE;
+    weights[slot]=nil;--loaded;return FR_OK;
+}}
+void gsq_radeon_close(void) { @autoreleasepool {
+    if(pending) [pending waitUntilCompleted];pending=nil;
+    for(unsigned i=0;i<3;++i) weights[i]=nil;
+    input=params=hidden=hq=scales=output=staging=nil;
+    gate4=gate8=quant=down=nil;queue=nil;dev=nil;loaded=max_units=0;
+}}
+int gsq_radeon_open(const char *source_path,unsigned units) { @autoreleasepool {
+    if(dev || !units || units>3) return FR_INVALID;
+    for(id<MTLDevice> d in MTLCopyAllDevices()) if(!d.hasUnifiedMemory && [d.name containsString:@"Radeon Pro 580"]) {dev=d;break;}
+    if(!dev) return FR_UNSUPPORTED;
+    const uint64_t reserve=512ULL*1024*1024,bytes=fr_gsq_unit_bytes();
+    if(bytes>dev.maxBufferLength || bytes*units+reserve>dev.recommendedMaxWorkingSetSize) {gsq_radeon_close();return FR_UNSUPPORTED;}
+    NSError *error=nil;NSString *source=nil;
+    if(source_path) source=[NSString stringWithContentsOfFile:@(source_path) encoding:NSUTF8StringEncoding error:&error];
+#ifdef FR_RADEON_EMBED
+    else source=@(gsq_radeon_shader_source);
+#endif
+    MTLCompileOptions *options=[MTLCompileOptions new];options.fastMathEnabled=NO;
+    id<MTLLibrary> lib=source?[dev newLibraryWithSource:source options:options error:&error]:nil;
+    if(lib) {
+        gate4=[dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"gate4"] error:&error];
+        gate8=[dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"gate8"] error:&error];
+        quant=[dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"quant_h"] error:&error];
+        down=[dev newComputePipelineStateWithFunction:[lib newFunctionWithName:@"down"] error:&error];
+    }
+    if(!gate4 || !gate8 || !quant || !down || gate4.threadExecutionWidth!=64 || gate8.threadExecutionWidth!=64 || quant.threadExecutionWidth!=64) {
+        if(error) fprintf(stderr,"Radeon shader: %s\n",error.localizedDescription.UTF8String);
+        gsq_radeon_close();return FR_UNSUPPORTED;
+    }
+    queue=[dev newCommandQueue];
+    params=[dev newBufferWithLength:sizeof(Params) options:MTLResourceStorageModeManaged];
+    input=[dev newBufferWithLength:8*2560*4 options:MTLResourceStorageModeManaged];
+    output=[dev newBufferWithLength:8*2560*4 options:MTLResourceStorageModeManaged];
+    hidden=private_buffer(3*80*8*32*4);hq=private_buffer(3*80*8*32);scales=private_buffer(3*80*8*4);
+    staging=[dev newBufferWithLength:64*1024*1024 options:MTLResourceStorageModeManaged];
+    if(!queue || !params || !input || !output || !hidden || !hq || !scales || !staging) {gsq_radeon_close();return FR_IO;}
+    max_units=units;uploaded=0;return FR_OK;
+}}
+int gsq_radeon_load(unsigned slot,const void *data,size_t size) { @autoreleasepool {
+    if(!dev || pending || !data || slot>=max_units || weights[slot] || size!=fr_gsq_unit_bytes()) return FR_INVALID;
+    if(!staging) staging=[dev newBufferWithLength:64*1024*1024 options:MTLResourceStorageModeManaged];
+    if(!staging) return FR_IO;
+    weights[slot]=private_buffer(size);if(!weights[slot]) return FR_IO;
+    for(size_t offset=0;offset<size;) {
+        size_t n=size-offset;if(n>staging.length)n=staging.length;
+        memcpy(staging.contents,(const char *)data+offset,n);[staging didModifyRange:NSMakeRange(0,n)];
+        id<MTLCommandBuffer> cb=[queue commandBuffer];id<MTLBlitCommandEncoder> e=[cb blitCommandEncoder];
+        if(!cb || !e){weights[slot]=nil;return FR_IO;}
+        [e copyFromBuffer:staging sourceOffset:0 toBuffer:weights[slot] destinationOffset:offset size:n];[e endEncoding];
+        [cb commit];[cb waitUntilCompleted];if(cb.status!=MTLCommandBufferStatusCompleted) {weights[slot]=nil;return FR_IO;}
+        offset+=n;uploaded+=n;
+    }
+    ++loaded;if(loaded==max_units) staging=nil;return FR_OK;
+}}
+int gsq_radeon_submit(const fr_req *req,const void *raw) { @autoreleasepool {
+    if(!dev || !loaded || pending || !req || !raw || req->layer>=48 || !req->burst || req->burst>8) return FR_INVALID;
+    id<MTLBuffer> active[3];unsigned n=0;
+    for(unsigned i=0;i<3;++i)if(weights[i])active[n++]=weights[i];
+    Params p={.offset=fr_gsq_layer_offset(req->layer),.row=(uint32_t)fr_gsq_row_bytes(req->layer),.piece=(uint32_t)fr_gsq_piece_bytes(req->layer),
+        .slice=(uint32_t)fr_gsq_slice_bytes(req->layer),.type=fr_gsq_gate_type[req->layer],.down=fr_gsq_down_type[req->layer],.burst=req->burst,.units=loaded};
+    float *x=input.contents;const unsigned char *xq=raw;

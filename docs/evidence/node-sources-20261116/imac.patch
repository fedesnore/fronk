+"    ggml_half d;\n"
+"    uint8_t qs[QK_K/4];\n"
+"    uint8_t qh[QK_K/32];\n"
+"    uint8_t signs[QK_K/8];\n"
+"    uint8_t scales[IQ3S_N_SCALE];\n"

+        for(unsigned d=0;d<2560;++d)r->x[t][d]=((int)((d*37+t*19)%257)-128)/128.f;
+    }
+    /* Widths 1..8 fit one GPU call; 9, 16 and FR_MAX_BURST check the chunked path,
+     * each against the scalar oracle on its last token. */
+    static const unsigned widths[]={1,2,3,4,5,6,7,8,9,16,FR_MAX_BURST};
+    for(unsigned l=0;l<48 && !rc;++l){
+        r->layer=l;

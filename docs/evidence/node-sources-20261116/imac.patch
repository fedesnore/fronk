+/* GSQ Radeon Pro 580 + existing CPU pool. Externally serialized.
+ * prepare transfers up to GPU_UNITS units to private VRAM; load keeps its ordinary
+ * borrowed-pointer contract. The loader releases transferred host mappings.
+ * Two units, not three: three left the 8 GiB card too little headroom under
+ * long prompts; the remaining units run on the CPU pool. */
+#include "gsq-radeon.h"
+#include "gsq.h"
+#include "bench.h"
+#include <math.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#define GPU_UNITS 2u
+static uint32_t cpu_mask,gpu_mask;
+static unsigned gpu_ids[GPU_UNITS],slots;
+static int opened;
+static fr_part cpu,gpu,complete;
+static unsigned char quantized[FR_MAX_BURST][FR_GSQ_Q8K_BYTES];
+static int probe(fr_hwinfo *out) {int rc=fr_gsq.probe(out);return rc?rc:gsq_radeon_probe();}
+static int valid_load(int b,const void *data,size_t len) {
+    if(b<0 || b>=FR_BLOCKS || !data || len!=fr_gsq_unit_bytes())return FR_INVALID;
+    return ((cpu_mask|gpu_mask)>>b&1)?FR_STATE:FR_OK;
+}
+static int load(int b,const void *data,size_t len) {
+    int rc=valid_load(b,data,len);if(rc)return rc;
+    rc=fr_gsq.load(b,data,len);if(!rc)cpu_mask|=1u<<b;return rc;
+}
+int fr_radeon_prepare(int b,const void *data,size_t len,int *host) {
+    if(!host)return FR_INVALID;
+    int rc=valid_load(b,data,len);if(rc)return rc;
+    *host=1;if(slots==(1u<<GPU_UNITS)-1)return load(b,data,len);
+    if(!opened){rc=gsq_radeon_open(NULL,GPU_UNITS);if(rc)return rc;opened=1;}
+    unsigned slot=0;while(slots>>slot&1)++slot;
+    rc=gsq_radeon_load(slot,data,len);if(rc)return rc;
+    slots|=1u<<slot;gpu_ids[slot]=(unsigned)b;gpu_mask|=1u<<b;*host=0;return FR_OK;
+}
+uint32_t fr_radeon_gpu_mask(void){return gpu_mask;}
+uint32_t fr_radeon_cpu_mask(void){return cpu_mask;}
+static int unload(int b) {
+    if(b<0 || b>=FR_BLOCKS)return FR_INVALID;
+    if(gpu_mask>>b&1){
+        for(unsigned i=0;i<GPU_UNITS;++i)if((slots>>i&1) && gpu_ids[i]==(unsigned)b){

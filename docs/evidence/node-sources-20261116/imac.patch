+    }
+    if(!(cpu_mask>>b&1))return FR_STATE;
+    int rc=fr_gsq.unload(b);if(!rc)cpu_mask&=~(1u<<b);return rc;
+}
+int fr_radeon_idle(void){return (cpu_mask|gpu_mask)?FR_STATE:fr_gsq_backend_close();}
+#define GPU_BURST 8u
+static fr_req gpu_req;static fr_part gpu_chunk;
+/* Tokens [c*GPU_BURST, ...) of r as one GPU request; raw holds Q8_K rows per token. */
+static int gpu_submit(const fr_req *r,const void *raw,unsigned c){
+    const unsigned base=c*GPU_BURST,n=r->burst-base<GPU_BURST?r->burst-base:GPU_BURST;
+    gpu_req.layer=r->layer;gpu_req.burst=n;
+    memcpy(gpu_req.expert,r->expert[base],n*sizeof(r->expert[0]));
+    memcpy(gpu_req.gate,r->gate[base],n*sizeof(r->gate[0]));
+    return gsq_radeon_submit(&gpu_req,(const unsigned char *)raw+(size_t)base*FR_GSQ_Q8K_BYTES);
+}
+static int gpu_collect(unsigned c){
+    int rc=gsq_radeon_collect(&gpu_chunk);if(rc)return rc;
+    memcpy(gpu.y[c*GPU_BURST],gpu_chunk.y,gpu_req.burst*sizeof(gpu.y[0]));return FR_OK;
+}
+int fr_radeon_run_q8(const fr_req *r,const void *raw,fr_part *out) {
+    if(!r || !raw || !out || r->layer>=FR_LAYERS || !r->burst || r->burst>FR_MAX_BURST)return FR_INVALID;
+    if(!(cpu_mask|gpu_mask))return FR_STATE;
+    int rc=FR_OK,grc=FR_OK;
+    /* The GPU kernels take at most GPU_BURST tokens: wider calls go to the GPU in
+     * chunks, the first overlapping the CPU's single full-width run. */
+    const unsigned chunks=(r->burst+GPU_BURST-1)/GPU_BURST;
+    if(gpu_mask){rc=gpu_submit(r,raw,0);if(rc)return rc;}
+    if(cpu_mask)rc=fr_gsq_run_quantized(r,raw,&cpu);
+    /* Drain GPU work even when the CPU fails. */
+    if(gpu_mask){
+        grc=gpu_collect(0);
+        for(unsigned c=1;c<chunks && !grc;++c){grc=gpu_submit(r,raw,c);if(!grc)grc=gpu_collect(c);}
+    }
+    if(rc || grc)return rc?rc:grc;
+    /* Only the call's rows: a whole fr_part is FR_MAX_BURST rows, paid on every decode call. */
+    for(unsigned t=0;t<r->burst;++t)for(unsigned d=0;d<FR_HIDDEN;++d){
+        float v=(cpu_mask?cpu.y[t][d]:0)+(gpu_mask?gpu.y[t][d]:0);
+        if(!isfinite(v))return FR_NUMERIC;complete.y[t][d]=v;
+    }
+    out->layer=r->layer;out->burst=r->burst;
+    memcpy(out->y,complete.y,r->burst*sizeof(out->y[0]));
+    memset(out->y[r->burst],0,(FR_MAX_BURST-r->burst)*sizeof(out->y[0]));return FR_OK;
+}
+static int run(const fr_req *r,fr_part *out) {
+    if(!r || !out || r->layer>=FR_LAYERS || !r->burst || r->burst>FR_MAX_BURST)return FR_INVALID;
+    for(unsigned t=0;t<r->burst;++t){
+        for(unsigned d=0;d<FR_HIDDEN;++d)if(!isfinite(r->x[t][d]))return FR_NUMERIC;
+        fr_gsq_quantize_x(r->x[t],quantized[t]);
+    }
+    return fr_radeon_run_q8(r,quantized,out);
+}
+static int bench(int burst,fr_costmodel *out){return fr_bench_execute_backend(&fr_module_gsq_radeon,burst,out);}
+/* Sparse correctness storage is never used for performance measurement. */
+static int self_test(const char *dir) {
+    (void)dir;if(cpu_mask|gpu_mask)return FR_STATE;
+    int rc=fr_gsq.self_test(NULL);if(rc)return rc;
+    size_t bytes=fr_gsq_unit_bytes();

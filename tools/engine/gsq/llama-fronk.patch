diff --git a/src/llama-fronk.cpp b/src/llama-fronk.cpp
new file mode 100644
index 0000000..a8f3f0a
--- /dev/null
+++ b/src/llama-fronk.cpp
@@ -0,0 +1,380 @@
+// llama-fronk.cpp - see llama-fronk.h.
+#include "llama-fronk.h"
+
+#include "fronk_client.h"
+
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <chrono>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+#include <sys/mman.h>
+#include <unistd.h>
+
+namespace {
+
+enum class mode { off, socket, ref, zero, sleep };
+
+mode fronk_mode() {
+    static const mode m = [] {
+        const char * sock = getenv("FRONK_MOE_SOCKET");
+        const char * loop = getenv("FRONK_MOE_LOOPBACK");
+        if (loop && !strcmp(loop, "ref"))  return mode::ref;
+        if (loop && !strcmp(loop, "zero")) return mode::zero;
+        if (loop && !strncmp(loop, "sleep", 5)) return mode::sleep;  // zero output after a fixed wait (timing only)
+        if (sock && *sock)                 return mode::socket;
+        return mode::off;
+    }();
+    return m;
+}
+
+struct layer_ctx {
+    int il;
+    ggml_tensor * up;
+    ggml_tensor * gate;
+    ggml_tensor * down;
+};
+
+// FRONK_MOE_PROFILE=1: where the head's time goes between expert calls.
+// "layer" = from one call's return to the next call in the same pass (GPU work of
+// one layer plus the GPU<->CPU hand-offs), "pass" = from the last layer's return
+// to the next pass's first call (output, sampling, MTP drafts), "cluster" = the call.
+struct profile {
+    bool on = getenv("FRONK_MOE_PROFILE") != nullptr;
+    double last_exit = 0, layer = 0, pass = 0, cluster = 0;
+    long n_layer = 0, n_pass = 0, n_call = 0, tokens = 0;
+    int last_il = -1;
+    static double now() {
+        return std::chrono::duration<double>(std::chrono::steady_clock::now().time_since_epoch()).count();
+    }
+    void enter(int il, double t) {
+        if (last_exit > 0 && t - last_exit < 1.0) {
+            if (il == last_il + 1) { layer += t - last_exit; ++n_layer; }
+            else                    { pass  += t - last_exit; ++n_pass;  }
+        }
+    }
+    void exit(int il, double t0, double t, long ntok) {
+        cluster += t - t0; ++n_call; tokens += ntok; last_exit = t; last_il = il;
+        if (n_call % 4800 == 0 && n_layer && n_pass) {
+            fprintf(stderr, "llama-fronk: width %.2f; per layer %.3f ms head + %.3f ms cluster; per pass %.2f ms between passes\n",
+                    (double) tokens / n_call, layer * 1e3 / n_layer, cluster * 1e3 / n_call, pass * 1e3 / n_pass);
+        }
+    }
+} g_prof;
+
+// One slot per layer; the tensors belong to the model and outlive every graph.
+layer_ctx g_layers[256];
+
+float dot_row(const ggml_tensor * w, int64_t row, const float * x, std::vector<float> & tmp) {
+    const int64_t n = w->ne[0];
+    const auto * traits = ggml_get_type_traits(w->type);
+    tmp.resize(n);
+    const char * src = (const char *) w->data + row * w->nb[1];
+    if (w->type == GGML_TYPE_F32) {
+        memcpy(tmp.data(), src, n * sizeof(float));
+    } else {
+        traits->to_float(src, tmp.data(), n);
+    }
+    double s = 0;
+    for (int64_t i = 0; i < n; ++i) s += (double) tmp[i] * x[i];
+    return (float) s;
+}
+
+// Reference routed sum for token t: sum_j w_j * down_e(silu(gate_e x) * up_e x).
+void ref_token(const layer_ctx & L, const float * x, const int32_t * ids, const float * w,
+               int n_used, float * y) {
+    const int64_t n_embd = L.up->ne[0];
+    const int64_t n_ff   = L.up->ne[1];
+    std::vector<float> tmp, h(n_ff);
+    std::vector<double> acc(n_embd, 0.0);
+    for (int j = 0; j < n_used; ++j) {
+        const int64_t e = ids[j];
+        for (int64_t n = 0; n < n_ff; ++n) {
+            const float g = dot_row(L.gate, e * n_ff + n, x, tmp);
+            const float u = dot_row(L.up,   e * n_ff + n, x, tmp);
+            h[n] = g / (1.0f + expf(-g)) * u;
+        }
+        for (int64_t d = 0; d < n_embd; ++d) {
+            acc[d] += (double) w[j] * dot_row(L.down, e * n_embd + d, h.data(), tmp);
+        }
+    }
+    for (int64_t d = 0; d < n_embd; ++d) y[d] = (float) acc[d];
+}
+
+// ---- the lifeboat (fronk_client.h) ----------------------------------------------------
+// One call computed here from the expert weights in the model file, with the arithmetic
+// of the reference mode. It is slow and it reads the SSD: it only ends a pass that the
+// cluster cannot answer, so that the engine stands between two passes and its context
+// can be saved instead of being lost with a fallen node or a stopped head.
+struct boat_state { bool on = false; long calls = 0, tokens = 0; double seconds = 0; } g_boat;
+
+bool boat_ready(const layer_ctx & L) {
+    for (const ggml_tensor * w : { L.up, L.gate, L.down }) {
+        if (!w || !w->data) return false;
+        if (w->type != GGML_TYPE_F32 && !ggml_get_type_traits(w->type)->to_float) return false;
+    }
+    return L.up->ne[0] == FRONK_HIDDEN && L.gate->ne[0] == FRONK_HIDDEN && L.gate->ne[1] == L.up->ne[1] &&
+           L.down->ne[0] == L.up->ne[1];
+}
+
+// The pages of an expert leave the active set as soon as they were used: one pass can
+// touch gigabytes of experts, and the head has no memory to keep them.
+void boat_forget(const ggml_tensor * w, int64_t first_row, int64_t rows) {
+    static const uintptr_t page = (uintptr_t) sysconf(_SC_PAGESIZE);
+    uintptr_t a = (uintptr_t) w->data + (uintptr_t) first_row * w->nb[1];
+    uintptr_t b = a + (uintptr_t) rows * w->nb[1];
+    a = (a + page - 1) / page * page; b = b / page * page;
+    if (b > a) (void) madvise((void *) a, b - a, MADV_DONTNEED);
+}
+
+// y[t] = sum_j weight(t,j) * down_e(silu(gate_e x_t) * up_e x_t), e = expert(t,j): the
+// sum of ref_token, with one job per token and expert spread over the cores.
+template <typename X, typename E, typename W>
+void boat_call(const layer_ctx & L, unsigned n_tok, X x_of, E expert_of, W weight_of, float * y) {
+    const int64_t n_embd = L.up->ne[0], n_ff = L.up->ne[1];
+    const unsigned n_jobs = n_tok * FRONK_ROUTED;
+    std::vector<float> part((size_t) n_jobs * n_embd);
+    std::atomic<unsigned> next{0};
+    auto work = [&] {
+        std::vector<float> tmp, h(n_ff);
+        for (unsigned job; (job = next.fetch_add(1)) < n_jobs; ) {
+            const unsigned t = job / FRONK_ROUTED, j = job % FRONK_ROUTED;
+            const int64_t e = expert_of(t, j);
+            const float * x = x_of(t);
+            float * out = part.data() + (size_t) job * n_embd;
+            for (int64_t n = 0; n < n_ff; ++n) {
+                const float g = dot_row(L.gate, e * n_ff + n, x, tmp);
+                const float u = dot_row(L.up,   e * n_ff + n, x, tmp);
+                h[n] = g / (1.0f + expf(-g)) * u;
+            }
+            for (int64_t d = 0; d < n_embd; ++d) out[d] = dot_row(L.down, e * n_embd + d, h.data(), tmp);
+            boat_forget(L.gate, e * n_ff, n_ff); boat_forget(L.up, e * n_ff, n_ff); boat_forget(L.down, e * n_embd, n_embd);
+        }
+    };
+    unsigned n_thr = std::thread::hardware_concurrency();
+    n_thr = n_thr > 4 ? n_thr - 2 : 2;
+    if (n_thr > n_jobs) n_thr = n_jobs;
+    std::vector<std::thread> pool;
+    for (unsigned i = 1; i < n_thr; ++i) pool.emplace_back(work);
+    work();
+    for (auto & th : pool) th.join();
+    for (unsigned t = 0; t < n_tok; ++t) {
+        for (int64_t d = 0; d < n_embd; ++d) {
+            double s = 0;
+            for (unsigned j = 0; j < FRONK_ROUTED; ++j) s += (double) weight_of(t, j) * part[((size_t) t * FRONK_ROUTED + j) * n_embd + d];
+            y[(size_t) t * n_embd + d] = (float) s;
+        }
+    }
+}
+
+// The call the client kept (fronk_call): what the cluster was asked and did not answer.
+void boat_kept_call(const layer_ctx & L, unsigned n_tok, float * y) {
+    boat_call(L, n_tok,
+              [](unsigned t) { return (const float *) fronk_call.x[t]; },
+              [](unsigned t, unsigned j) { return (int64_t) fronk_call.e[t][j]; },
+              [](unsigned t, unsigned j) { return fronk_call.g[t][j]; }, y);
+}
+
+void boat_begin(const layer_ctx & L) {
+    if (!boat_ready(L)) {
+        fprintf(stderr, "llama-fronk: lifeboat asked at layer %d, but its expert weights cannot be read here\n", L.il);
+        abort();
+    }
+    if (!g_boat.on) {
+        g_boat = boat_state();
+        g_boat.on = true;
+        fprintf(stderr, "llama-fronk: lifeboat on at layer %d: the cluster does not answer, the expert calls of this pass are computed here from the model file\n", L.il);
+    }
+}
+
+void boat_end(double t0, unsigned n_tok) {
+    g_boat.seconds += profile::now() - t0; g_boat.tokens += n_tok;
+    if (++g_boat.calls % 16 == 0) fprintf(stderr, "llama-fronk: lifeboat: %ld calls, %ld tokens, %.1f s so far\n", g_boat.calls, g_boat.tokens, g_boat.seconds);
+}
+
+// The cluster answers again.
+void boat_off() {
+    if (!g_boat.on) return;
+    fprintf(stderr, "llama-fronk: lifeboat off after %ld calls, %ld tokens, %.1f s\n", g_boat.calls, g_boat.tokens, g_boat.seconds);
+    g_boat.on = false;
+}
+
+// FRONK_MOE_LIFEBOAT_CHECK=N (diagnostic, it reads the SSD): one call in N of every
+// layer (N=1: only the first) is also computed by the lifeboat, from the model file, and
+// compared with the cluster's answer, which sums the expert cache and the slices.
+// Checks spread over a generation also cover the experts the cache has replaced since.
+void boat_check(const layer_ctx & L, unsigned n_tok, const float * cluster) {
+    static const long every = [] { const char * v = getenv("FRONK_MOE_LIFEBOAT_CHECK"); if (!v) return 0L; const long n = atol(v); return n > 1 ? n : 1L; }();
+    static long seen[256];
+    if (!every) return;
+    const long n = seen[L.il]++;
+    if (every == 1 ? n != 0 : n % every != 0) return;
+    if (!boat_ready(L)) { fprintf(stderr, "llama-fronk: lifeboat check layer %d: expert weights cannot be read here\n", L.il); return; }
+    const double t0 = profile::now();
+    std::vector<float> mine((size_t) n_tok * FRONK_HIDDEN);
+    boat_kept_call(L, n_tok, mine.data());
+    double diff = 0, norm = 0;
+    for (size_t i = 0; i < mine.size(); ++i) { const double d = (double) mine[i] - cluster[i]; diff += d * d; norm += (double) mine[i] * mine[i]; }
+    fprintf(stderr, "llama-fronk: lifeboat check layer %d: relative_l2 %.4g against the cluster (%u tokens, types %s %s %s, %.2f s)\n",
+            L.il, norm > 0 ? sqrt(diff / norm) : -1.0, n_tok, ggml_type_name(L.gate->type), ggml_type_name(L.up->type),
+            ggml_type_name(L.down->type), profile::now() - t0);
+}
+
+std::mutex socket_mu;
+double overlap_start;
+
+void fronk_send_op(ggml_tensor * dst, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    const layer_ctx & L = *(const layer_ctx *) userdata;
+    const ggml_tensor * x = dst->src[0], * ids = dst->src[1], * weights = dst->src[2];
+    GGML_ASSERT(x->type == GGML_TYPE_F32 && ids->type == GGML_TYPE_I32 && weights->type == GGML_TYPE_F32);
+    GGML_ASSERT(x->ne[0] == FRONK_HIDDEN && x->ne[1] > 0 && x->ne[1] <= FRONK_BURST);
+    GGML_ASSERT(ids->ne[0] == FRONK_ROUTED && ids->ne[1] == x->ne[1]);
+    GGML_ASSERT(weights->ne[0] == FRONK_ROUTED && weights->ne[1] == x->ne[1]);
+    GGML_ASSERT(ggml_is_contiguous(x) && ggml_is_contiguous(ids) && ggml_is_contiguous(weights));
+    std::lock_guard<std::mutex> lock(socket_mu);
+    overlap_start = g_prof.on ? profile::now() : 0;
+    if (g_prof.on) g_prof.enter(L.il, overlap_start);
+    if (fronk_submit(L.il, x->ne[1], (const float *) x->data, (const int32_t *) ids->data,
+                     (const float *) weights->data, nullptr)) {
+        fprintf(stderr, "llama-fronk: submit failed at layer %d\n", L.il);
+        abort();
+    }
+    memset(dst->data, 0, ggml_nbytes(dst));
+}
+
+void fronk_collect_op(ggml_tensor * dst, int ith, int, void * userdata) {
+    if (ith != 0) return;
+    const layer_ctx & L = *(const layer_ctx *) userdata;
+    std::lock_guard<std::mutex> lock(socket_mu);
+    uint32_t missing = 0;
+    const unsigned n_tok = (unsigned) dst->ne[1];
+    const int rc = fronk_collect(L.il, n_tok, (float *) dst->data, &missing);
+    if (rc == 1) {
+        const double t0 = profile::now();
+        boat_begin(L);
+        boat_kept_call(L, n_tok, (float *) dst->data);
+        boat_end(t0, n_tok);
+    } else if (rc || missing) {
+        fprintf(stderr, "llama-fronk: collect failed at layer %d\n", L.il);
+        abort();
+    } else {
+        boat_off();
+        boat_check(L, n_tok, (const float *) dst->data);
+    }
+    if (g_prof.on) g_prof.exit(L.il, overlap_start, profile::now(), dst->ne[1]);
+}
+
+void fronk_op(ggml_tensor * dst, int ith, int nth, void * userdata) {
+    const layer_ctx & L = *(const layer_ctx *) userdata;
+    const ggml_tensor * x   = dst->src[0];
+    const ggml_tensor * sel = dst->src[1];
+    const ggml_tensor * wts = dst->src[2];
+    const int64_t n_embd  = x->ne[0];
+    const int64_t n_tok   = x->ne[1];
+    const int     n_used  = (int) sel->ne[0];
+    float * y = (float *) dst->data;
+
+    switch (fronk_mode()) {
+        case mode::zero:
+            if (ith == 0) memset(y, 0, ggml_nbytes(dst));
+            return;
+        case mode::sleep: {
+            if (ith != 0) return;
+            static const double wait_s = [] { const char * v = getenv("FRONK_MOE_LOOPBACK"); return (v[5] == ':' ? atof(v + 6) : 3000.0) * 1e-6; }();
+            const double t0 = profile::now();
+            if (g_prof.on) g_prof.enter(L.il, t0);
+            while (profile::now() - t0 < wait_s) { }
+            memset(y, 0, ggml_nbytes(dst));
+            if (g_prof.on) g_prof.exit(L.il, t0, profile::now(), (long) n_tok);
+            return;
+        }
+        case mode::ref:
+            for (int64_t t = ith; t < n_tok; t += nth) {
+                ref_token(L, (const float *) ((const char *) x->data + t * x->nb[1]),
+                          (const int32_t *) ((const char *) sel->data + t * sel->nb[1]),
+                          (const float *) ((const char *) wts->data + t * wts->nb[1]),
+                          n_used, y + t * n_embd);
+            }
+            return;
+        case mode::socket: {
+            if (ith != 0) return;
+            if (n_embd != FRONK_HIDDEN || n_used != FRONK_ROUTED) {
+                fprintf(stderr, "llama-fronk: expected %d hidden and %d routed, got %lld and %d\n",
+                        FRONK_HIDDEN, FRONK_ROUTED, (long long) n_embd, n_used);
+                abort();
+            }
+            std::lock_guard<std::mutex> lock(socket_mu);
+            const double t0 = g_prof.on ? profile::now() : 0;
+            if (g_prof.on) g_prof.enter(L.il, t0);
+            uint32_t missing = 0;
+            // NULL shared gate: llama.cpp adds the shared expert itself.
+            const int rc = fronk_moe((unsigned) L.il, (unsigned) n_tok, (const float *) x->data,
+                                     (const int32_t *) sel->data, (const float *) wts->data, nullptr, y, &missing);
+            if (rc == 1) {
+                // The lifeboat: every token of this call, from the op's own inputs.
+                const float * xs = (const float *) x->data; const int32_t * es = (const int32_t *) sel->data;
+                const float * ws = (const float *) wts->data;
+                const double tb = profile::now();
+                boat_begin(L);
+                boat_call(L, (unsigned) n_tok,
+                          [&](unsigned t) { return xs + (size_t) t * FRONK_HIDDEN; },
+                          [&](unsigned t, unsigned j) { return (int64_t) es[(size_t) t * FRONK_ROUTED + j]; },
+                          [&](unsigned t, unsigned j) { return ws[(size_t) t * FRONK_ROUTED + j]; }, y);
+                boat_end(tb, (unsigned) n_tok);
+                missing = 0;
+            } else if (rc) {
+                fprintf(stderr, "llama-fronk: expert call failed at layer %d\n", L.il);
+                abort();  // never continue with a partial sum
+            } else {
+                boat_off();
+            }
+            if (missing) {
+                fprintf(stderr, "llama-fronk: layer %d missing nodes 0x%x\n", L.il, missing);
+                abort();
+            }
+            if (g_prof.on) g_prof.exit(L.il, t0, profile::now(), (long) n_tok);
+            return;
+        }
+        case mode::off:
+            return;
+    }
+}
+
+}  // namespace
+
+bool llama_fronk_wants(int il, int n_trunk) {
+    return fronk_mode() != mode::off && il >= 0 && il < n_trunk && il < 256;
+}
+
+ggml_tensor * llama_fronk_moe(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * selected,
+                              ggml_tensor * weights, ggml_tensor * up_exps, ggml_tensor * gate_exps,
+                              ggml_tensor * down_exps, int il) {
+    g_layers[il] = { il, up_exps, gate_exps, down_exps };
+    ggml_tensor * args[3] = {
+        ggml_cont(ctx, cur),
+        ggml_cont(ctx, selected),
+        ggml_cont(ctx, ggml_reshape_2d(ctx, weights, selected->ne[0], selected->ne[1])),
+    };
+    const int n_tasks = fronk_mode() == mode::ref ? GGML_N_TASKS_MAX : 1;
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, cur->ne[0], cur->ne[1], 1, 1, args, 3,
+                          llama_fronk_overlap(cur->ne[1]) ? fronk_send_op : fronk_op, n_tasks, &g_layers[il]);
+}
+
+bool llama_fronk_overlap(int64_t n_tokens) {
+    const char * flag = getenv("FRONK_MOE_OVERLAP");
+    return flag && !strcmp(flag, "1") && fronk_mode() == mode::socket && n_tokens > 0 && n_tokens <= FRONK_BURST;
+}
+
+ggml_tensor * llama_fronk_finish(ggml_context * ctx, ggml_tensor * sent, ggml_tensor * shared, int il) {
+    GGML_ASSERT(il >= 0 && il < 256 && llama_fronk_overlap(sent->ne[1]));
+    // The dependency waits for shared work without copying its full output to CPU.
+    ggml_tensor * args[2] = { sent, shared ? ggml_view_1d(ctx, shared, 1, 0) : nullptr };
+    return ggml_custom_4d(ctx, GGML_TYPE_F32, sent->ne[0], sent->ne[1], 1, 1, args, shared ? 2 : 1,
+                          fronk_collect_op, 1, &g_layers[il]);
+}

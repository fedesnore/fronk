+// The draft file repeats the target model's token table and output head byte for byte
+// (710 MB for Qwen3.8-Flash-Next). When this context drafts for a target whose two
+// tensors have the same shape, type and first and last bytes, the draft graph reads the
+// target's, which are in memory for the trunk anyway, and its own copies stay on disk.
+// A draft is always verified by the target, so a wrong guess could only cost drafts.
+// FRONK_MTP_OWN_TABLES=1 keeps the draft model on its own copies.
+static const llama_model * mtp_shared_model(const llama_model & model, const llama_cparams & cparams) {
+    static const bool own = getenv("FRONK_MTP_OWN_TABLES") != nullptr;
+    if (own || !cparams.ctx_tables) {
+        return nullptr;
+    }
+    const llama_model * other = llama_get_model(cparams.ctx_tables);
+    if (!other || other == &model || !model.tok_embd || !model.output || !other->tok_embd || !other->output) {
+        return nullptr;
+    }
+    // a model loaded only to measure its memory has no buffers: no answer is kept for it
+    if (!model.tok_embd->buffer || !model.output->buffer || !other->tok_embd->buffer || !other->output->buffer) {
+        return nullptr;
+    }
+    // one answer for each pair of loaded models
+    static const llama_model * asked_model = nullptr;
+    static const llama_model * asked_other = nullptr;
+    static bool answer = false;
+    if (asked_model != &model || asked_other != other) {
+        auto same = [](ggml_tensor * a, ggml_tensor * b) {
+            if (a->type != b->type || !ggml_are_same_shape(a, b)) {
+                return false;
+            }
+            const size_t n = ggml_nbytes(a);
+            const size_t k = n < 4096 ? n : 4096;
+            std::vector<uint8_t> x(k), y(k);
+            for (const size_t off : { (size_t) 0, n - k }) {
+                ggml_backend_tensor_get(a, x.data(), off, k);
+                ggml_backend_tensor_get(b, y.data(), off, k);
+                if (memcmp(x.data(), y.data(), k) != 0) {
+                    return false;
+                }
+            }
+            return true;
+        };
+        answer = same(model.tok_embd, other->tok_embd) && same(model.output, other->output) &&
+                 (model.output_s == nullptr) == (other->output_s == nullptr);
+        asked_model = &model;
+        asked_other = other;
+        LLAMA_LOG_WARN("%s: the draft model %s the target\x27s token table and output head\n", __func__,
+                answer ? "shares" : "keeps its own copies, not");
+    }
+    return answer ? other : nullptr;
+}

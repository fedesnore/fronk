+// llama-fronk.h - routed experts of Qwen3.8-Flash-Next on the Fronk cluster.
+//
+// build_moe_ffn keeps the router (softmax, top 10, normalized weights) and, for
+// the 48 trunk layers of qwen4exp, hands the routed-expert computation to one
+// custom op. The op runs on the CPU backend and is chosen by environment:
+//   FRONK_MOE_SOCKET=PATH     send x, expert ids and weights to the Fronk head
+//                             (client/fronk_client.h); the shared expert stays in
+//                             llama.cpp, so its gate in the request is 0
+//   FRONK_MOE_LOOPBACK=ref    compute the routed sum here from the model's own
+//                             expert tensors with ggml's reference dequantizers
+//                             (slow; for parity against the unhooked graph)
+//                             Run it with --no-repack: on the CPU llama.cpp may
+//                             repack expert weights into its own layout, which
+//                             this path does not read.
+//   FRONK_MOE_LOOPBACK=zero   return zeros (wrong output; measures the cost of
+//                             leaving the GPU graph once per layer)
+// Without either variable the graph is unchanged.
+#pragma once
+
+#include "ggml.h"
+
+// True when the routed experts of trunk layer il (of n_trunk) go through the hook.
+bool llama_fronk_wants(int il, int n_trunk);
+
+// cur [n_embd, n_tokens] F32, selected [n_used, n_tokens] I32,
+// weights [n_used, n_tokens] F32 (normalized and scaled as build_moe_ffn does).
+// Returns the routed sum [n_embd, n_tokens] F32.
+ggml_tensor * llama_fronk_moe(ggml_context * ctx, ggml_tensor * cur, ggml_tensor * selected,
+                              ggml_tensor * weights, ggml_tensor * up_exps, ggml_tensor * gate_exps,
+                              ggml_tensor * down_exps, int il);
+
+// Opt-in overlap for decode-sized batches; larger prefills use the synchronous path.
+bool llama_fronk_overlap(int64_t n_tokens);
+ggml_tensor * llama_fronk_finish(ggml_context * ctx, ggml_tensor * sent, ggml_tensor * shared, int il);

+
+/* fronk: routed + shared experts of layers 0..47 run on the fronk cluster when
+ * FRONK_MOE_SOCKET is set. Inputs are read after the router; the gated sum is
+ * written into part slot 0 and the existing reduce (weights 1, no shared
+ * source) applies the hyper-connection injection unchanged. MTP stays local. */
+#include "fronk_client.h"
+fronk_moe_hook_fn fronk_moe_hook;  /* set by a program that links ds4 and serves the experts itself */
+static int qwen4_fronk_layer(const ds4_layer_weights *l) {
+    const char *p = l->ffn_gate_exps->name.ptr; size_t n = l->ffn_gate_exps->name.len; int layer = 0;
+    if (n < 5 || memcmp(p, "blk.", 4)) return -1;
+    for (size_t i = 4; i < n && p[i] >= '0' && p[i] <= '9'; i++) layer = layer * 10 + (p[i] - '0');
+    return layer < 48 ? layer : -1;
+}
+/* FRONK_PROFILE=1: per-call time split at the fronk call site, printed every 480 calls. */
+static double qwen4_fronk_now(void) { struct timespec t; clock_gettime(CLOCK_MONOTONIC, &t); return t.tv_sec * 1e6 + t.tv_nsec / 1e3; }
+static int qwen4_fronk_env(const char *name, int dflt) { const char *v = getenv(name); return v && *v ? atoi(v) != 0 : dflt; }
+
+/* Synchronous path (FRONK_PIPELINE=0): stop the GPU, call fronk, restart. */
+static bool qwen4_graph_moe_fronk_sync(ds4_qwen4_gpu_graph *g, const ds4_layer_weights *l, uint32_t T) {
+    static float *x, *w, *sh, *y, *ones; static int32_t *ids; static uint32_t cap;
+    if (T > cap) {
+        x = realloc(x, (size_t)T * DS4_N_EMBD * sizeof(float)); y = realloc(y, (size_t)T * DS4_N_EMBD * sizeof(float));
+        w = realloc(w, (size_t)T * DS4_N_EXPERT_USED * sizeof(float)); ids = realloc(ids, (size_t)T * DS4_N_EXPERT_USED * sizeof(int32_t));
+        sh = realloc(sh, T * sizeof(float)); ones = realloc(ones, T * sizeof(float));
+        if (!x || !y || !w || !ids || !sh || !ones) return false;
+        cap = T;
+    }
+    for (uint32_t t = 0; t < T; t++) ones[t] = 1.0f;
+    uint32_t missing = 0;
+    bool ok = ds4_gpu_end_commands() != 0 &&
+        ds4_gpu_tensor_read(g->mixed, 0, x, (uint64_t)T * DS4_N_EMBD * sizeof(float)) != 0 &&
+        ds4_gpu_tensor_read(g->selected, 0, ids, (uint64_t)T * DS4_N_EXPERT_USED * sizeof(int32_t)) != 0 &&
+        ds4_gpu_tensor_read(g->weights, 0, w, (uint64_t)T * DS4_N_EXPERT_USED * sizeof(float)) != 0 &&
+        ds4_gpu_tensor_read(g->sh_gate_logit, 0, sh, (uint64_t)T * sizeof(float)) != 0 &&
+        fronk_moe((unsigned)qwen4_fronk_layer(l), T, x, ids, w, sh, y, &missing) == 0 &&
+        ds4_gpu_tensor_write(g->part, 0, y, (uint64_t)T * DS4_N_EMBD * sizeof(float)) != 0 &&
+        ds4_gpu_tensor_write(g->weights, 0, ones, (uint64_t)T * sizeof(float)) != 0;
+    if (!ok) fprintf(stderr, "ds4: fronk expert call failed for %.*s\n", (int)l->ffn_gate_exps->name.len, l->ffn_gate_exps->name.ptr);
+    ok = ds4_gpu_begin_commands() != 0 && ok;
+    return ok && ds4_gpu_qwen4_moe_reduce_tensor(g->blk, g->part, g->weights, NULL, NULL, g->R, g->inj,
+                                                 T, 1, 1, DS4_N_EMBD, DS4_N_HC) != 0;
+}
+
+#ifdef DS4_HAS_QWEN4_METAL
+/* Pipelined path: the GPU signals when a layer's expert inputs are ready, runs
+ * the shared expert itself, then waits for the cluster's sum. A worker thread
+ * serves the fronk calls in order, so the main thread keeps encoding and the
+ * GPU is never stopped from the CPU. */
+typedef struct { ds4_qwen4_gpu_graph *g; unsigned layer; uint32_t T; uint64_t ready, resume; bool shared_local; } qwen4_fronk_job;
+static struct {
+    pthread_mutex_t mu; pthread_cond_t cv; pthread_t th; bool started;
+    qwen4_fronk_job q[512]; unsigned head, tail; volatile int error; uint64_t seq;
+} qwen4_fronk = { .mu = PTHREAD_MUTEX_INITIALIZER, .cv = PTHREAD_COND_INITIALIZER };
+static void *qwen4_fronk_worker(void *arg) {
+    (void)arg;
+    float *x = NULL, *w = NULL, *sh = NULL, *y = NULL, *ones = NULL; int32_t *ids = NULL; uint32_t cap = 0;
+    const int prof = getenv("FRONK_PROFILE") != NULL; double acc[6] = {0}, last = 0; unsigned calls = 0;
+    for (;;) {
+        pthread_mutex_lock(&qwen4_fronk.mu);
+        while (qwen4_fronk.head == qwen4_fronk.tail) pthread_cond_wait(&qwen4_fronk.cv, &qwen4_fronk.mu);
+        qwen4_fronk_job j = qwen4_fronk.q[qwen4_fronk.head % 512]; qwen4_fronk.head++;
+        pthread_mutex_unlock(&qwen4_fronk.mu);
+        const uint32_t T = j.T; bool ok = true;
+        if (T > cap) {
+            x = realloc(x, (size_t)T * DS4_N_EMBD * sizeof(float)); y = realloc(y, (size_t)T * DS4_N_EMBD * sizeof(float));
+            w = realloc(w, (size_t)T * DS4_N_EXPERT_USED * sizeof(float)); ids = realloc(ids, (size_t)T * DS4_N_EXPERT_USED * sizeof(int32_t));
+            sh = realloc(sh, T * sizeof(float)); ones = realloc(ones, T * sizeof(float));
+            ok = x && y && w && ids && sh && ones; cap = ok ? T : 0;
+        }
+        const double t0 = prof ? qwen4_fronk_now() : 0;
+        ok = ok && ds4_gpu_fronk_wait(j.ready, 120000.0) != 0;
+        const double t1 = prof ? qwen4_fronk_now() : 0;
+        uint32_t missing = 0;
+        if (ok) for (uint32_t t = 0; t < T; t++) ones[t] = 1.0f;
+        ok = ok &&
+            ds4_gpu_tensor_read(j.g->mixed, 0, x, (uint64_t)T * DS4_N_EMBD * sizeof(float)) != 0 &&
+            ds4_gpu_tensor_read(j.g->selected, 0, ids, (uint64_t)T * DS4_N_EXPERT_USED * sizeof(int32_t)) != 0 &&
+            ds4_gpu_tensor_read(j.g->weights, 0, w, (uint64_t)T * DS4_N_EXPERT_USED * sizeof(float)) != 0 &&
+            (j.shared_local || ds4_gpu_tensor_read(j.g->sh_gate_logit, 0, sh, (uint64_t)T * sizeof(float)) != 0) &&
+            fronk_moe(j.layer, T, x, ids, w, j.shared_local ? NULL : sh, y, &missing) == 0;
+        const double t2 = prof ? qwen4_fronk_now() : 0;
+        ok = ok &&
+            ds4_gpu_tensor_write(j.g->part, 0, y, (uint64_t)T * DS4_N_EMBD * sizeof(float)) != 0 &&
+            ds4_gpu_tensor_write(j.g->weights, 0, ones, (uint64_t)T * sizeof(float)) != 0;
+        if (!ok) { qwen4_fronk.error = 1; fprintf(stderr, "ds4: fronk expert call failed for layer %u\n", j.layer); }
+        if (!ds4_gpu_fronk_signal(j.resume)) { /* always: the GPU must never wait forever */
+            qwen4_fronk.error = 1; fprintf(stderr, "ds4: fronk GPU resume poll timed out\n");
+        }
+        if (prof) {
+            /* idle: worker waiting for the main thread to queue the next layer;
+             * gaps over 2 ms are step boundaries (sampling, MTP draft, output head). */
+            if (last > 0 && t0 - last < 1e6) { if (t0 - last > 2000) { acc[4] += t0 - last; acc[5]++; } else acc[0] += t0 - last; }
+            acc[1] += t1 - t0; acc[2] += t2 - t1; acc[3] += T; last = qwen4_fronk_now();
+            if (++calls % 480 == 0) {
+                fprintf(stderr, "FRONK_PROFILE pipeline calls=%u avg_T=%.2f us/call: idle=%.0f gpu_until_ready=%.0f cluster=%.0f; boundaries=%.0f avg=%.0f us\n",
+                        calls, acc[3] / 480, acc[0] / 480, acc[1] / 480, acc[2] / 480, acc[5], acc[5] ? acc[4] / acc[5] : 0);
+                memset(acc, 0, sizeof(acc));
+            }
+        }
+    }
+    return NULL;
+}
+static bool qwen4_graph_moe_fronk_pipe(ds4_qwen4_gpu_graph *g, const ds4_model *m, const ds4_layer_weights *l, uint32_t T) {
+    static int shared_local = -1;
+    if (shared_local < 0) shared_local = qwen4_fronk_env("FRONK_SHARED_LOCAL", 1) &&
+        qwen4_graph_dense_ok(l->ffn_gate_shexp) && qwen4_graph_dense_ok(l->ffn_up_shexp) && qwen4_graph_dense_ok(l->ffn_down_shexp);
+    if (!qwen4_fronk.started) {
+        if (pthread_create(&qwen4_fronk.th, NULL, qwen4_fronk_worker, NULL) != 0) return false;
+        pthread_detach(qwen4_fronk.th); qwen4_fronk.started = true;
+    }
+    if (qwen4_fronk.error) return false;
+    const uint64_t seq = ++qwen4_fronk.seq, ready = 2 * seq - 1, resume = 2 * seq;
+    bool ok = ds4_gpu_fronk_ready(ready) != 0;
+    /* The shared expert runs on this GPU while the cluster computes the routed ones. */
+    if (ok && shared_local)
+        ok = qwen4_gemv(g->sh_gate, m, l->ffn_gate_shexp, g->mixed, T) &&
+             qwen4_gemv(g->sh_up, m, l->ffn_up_shexp, g->mixed, T) &&
+             ds4_gpu_swiglu_tensor(g->sh_mid, g->sh_gate, g->sh_up, T * DS4_N_FF_EXP, 0.0f, 1.0f) &&
+             qwen4_gemv(g->sh_out, m, l->ffn_down_shexp, g->sh_mid, T);
+    pthread_mutex_lock(&qwen4_fronk.mu);
+    if (qwen4_fronk.tail - qwen4_fronk.head >= 512) ok = false;
+    else qwen4_fronk.q[qwen4_fronk.tail++ % 512] = (qwen4_fronk_job){ g, (unsigned)qwen4_fronk_layer(l), T, ready, resume, shared_local == 1 };
+    pthread_cond_signal(&qwen4_fronk.cv);
+    pthread_mutex_unlock(&qwen4_fronk.mu);
+    ok = ok && ds4_gpu_fronk_resume(resume) != 0;
+    return ok && ds4_gpu_qwen4_moe_reduce_tensor(g->blk, g->part, g->weights,
+                                                 shared_local ? g->sh_gate_logit : NULL, shared_local ? g->sh_out : NULL,
+                                                 g->R, g->inj, T, 1, 1, DS4_N_EMBD, DS4_N_HC) != 0;
+}
+#endif
+
+static bool qwen4_graph_moe_fronk(ds4_qwen4_gpu_graph *g, const ds4_model *m, const ds4_layer_weights *l, uint32_t T) {
+#ifdef DS4_HAS_QWEN4_METAL
+    static int pipe = -1;
+    if (pipe < 0) pipe = qwen4_fronk_env("FRONK_PIPELINE", 1);
+    if (pipe) return qwen4_graph_moe_fronk_pipe(g, m, l, T);
+#else
+    (void)m;
+#endif
+    return qwen4_graph_moe_fronk_sync(g, l, T);
+}
+/* FRONK_LOCAL_PREFILL=N: batches above N tokens (prompt reading) run their
+ * experts here from the SSD-streamed GGUF, the same weights the nodes hold, and
+ * decoding (1-2 tokens per pass) stays on the cluster. Unset: all on the cluster. */
+static bool qwen4_fronk_prefill_local(uint32_t T) {
+    static long threshold = -2;
+    if (threshold == -2) { const char *v = getenv("FRONK_LOCAL_PREFILL"); threshold = v && *v ? strtol(v, NULL, 10) : -1; }
+    return threshold >= 0 && T > (uint32_t)threshold;
+}

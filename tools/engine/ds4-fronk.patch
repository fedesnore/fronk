diff --git a/fronk_client.h b/fronk_client.h
new file mode 100644
index 0000000..539d8b7
--- /dev/null
+++ b/fronk_client.h
@@ -0,0 +1,70 @@
+/* fronk_client.h - header-only client for the head's expert service (like
+ * hiredis, but one call). The engine passes the routed-expert inputs of one
+ * layer and receives the gated sum of routed + shared experts. It knows
+ * nothing about ds4. Enabled when FRONK_MOE_SOCKET names the head's socket.
+ * Wire format: see src/serve.h. Bursts above 8 tokens are sent in chunks.
+ */
+#ifndef FRONK_CLIENT_H
+#define FRONK_CLIENT_H
+#include <math.h>
+#include <stdint.h>
+#include <stdlib.h>
+#include <string.h>
+#include <unistd.h>
+#include <sys/socket.h>
+#include <sys/un.h>
+#define FRONK_HIDDEN 2560
+#define FRONK_ROUTED 10
+#define FRONK_BURST 8
+static int fronk_fd=-1;
+/* In-process: a program that links ds4 (fronk head) sets this hook before the
+ * engine starts, and every expert call becomes a function call into its head
+ * plane: no socket, no second process. e[b][10] ids, g[b][11] gates (shared
+ * last, 0 when the caller adds the shared expert), x and y [b][2560]. */
+typedef int (*fronk_moe_hook_fn)(unsigned layer,unsigned b,const uint16_t (*e)[FRONK_ROUTED],
+                                 const float (*g)[FRONK_ROUTED+1],const float *x,float *y,uint32_t *missing);
+extern fronk_moe_hook_fn fronk_moe_hook;
+static int fronk_enabled(void) { const char *p=getenv("FRONK_MOE_SOCKET"); return fronk_moe_hook || (p && *p); }
+static int fronk_io(void *p,size_t n,int out) {
+    for (char *c=p;n;) { ssize_t k=out?send(fronk_fd,c,n,0):recv(fronk_fd,c,n,0); if (k<=0) return -1; c+=k; n-=(size_t)k; }
+    return 0;
+}
+static int fronk_connect(void) {
+    if (fronk_fd>=0) return 0;
+    struct sockaddr_un a; memset(&a,0,sizeof(a)); a.sun_family=AF_UNIX;
+    const char *path=getenv("FRONK_MOE_SOCKET"); if (!path || strlen(path)>=sizeof(a.sun_path)) return -1;
+    strcpy(a.sun_path,path);
+    if ((fronk_fd=socket(AF_UNIX,SOCK_STREAM,0))<0) return -1;
+    if (connect(fronk_fd,(struct sockaddr *)&a,sizeof(a))) { close(fronk_fd); fronk_fd=-1; return -1; }
+    return 0;
+}
+/* x[T][2560] expert input, ids/weights[T][10] router choice, shared_logit[T]
+ * raw shared-expert gate (sigmoid applied here; NULL leaves the shared expert to
+ * the caller), y[T][2560] gated sum. */
+static int fronk_moe(unsigned layer,unsigned T,const float *x,const int32_t *ids,const float *weights,
+                     const float *shared_logit,float *y,uint32_t *missing) {
+    if (!fronk_moe_hook && fronk_connect()) return -1;
+    *missing=0;
+    for (unsigned base=0;base<T;base+=FRONK_BURST) {
+        uint32_t b=T-base<FRONK_BURST?T-base:FRONK_BURST,head[3]={0x4b4e5246u,layer,b},miss; int32_t status;
+        uint16_t e[FRONK_BURST][FRONK_ROUTED]; float g[FRONK_BURST][FRONK_ROUTED+1];
+        for (unsigned t=0;t<b;++t) {
+            for (unsigned j=0;j<FRONK_ROUTED;++j) { e[t][j]=(uint16_t)ids[(base+t)*FRONK_ROUTED+j]; g[t][j]=weights[(base+t)*FRONK_ROUTED+j]; }
+            g[t][FRONK_ROUTED]=shared_logit?1.0f/(1.0f+expf(-shared_logit[base+t])):0.0f; /* NULL: caller adds the shared expert */
+        }
+        if (fronk_moe_hook) {
+            if (fronk_moe_hook(layer,b,(const uint16_t (*)[FRONK_ROUTED])e,(const float (*)[FRONK_ROUTED+1])g,
+                               x+(size_t)base*FRONK_HIDDEN,y+(size_t)base*FRONK_HIDDEN,&miss)) return -1;
+            *missing|=miss; continue;
+        }
+        if (fronk_io(head,sizeof(head),1) || fronk_io(e,b*sizeof(e[0]),1) || fronk_io(g,b*sizeof(g[0]),1) ||
+            fronk_io((void *)(x+(size_t)base*FRONK_HIDDEN),(size_t)b*FRONK_HIDDEN*sizeof(float),1) ||
+            fronk_io(&status,4,0) || fronk_io(&miss,4,0) || fronk_io(y+(size_t)base*FRONK_HIDDEN,(size_t)b*FRONK_HIDDEN*sizeof(float),0)) {
+            close(fronk_fd); fronk_fd=-1; return -1;
+        }
+        if (status) return -1;
+        *missing|=miss;
+    }
+    return 0;
+}
+#endif
diff --git a/fronkensteen/chat.inc b/fronkensteen/chat.inc
new file mode 100644
index 0000000..1139b9d
--- /dev/null
+++ b/fronkensteen/chat.inc
@@ -0,0 +1,71 @@
+/* Local chat pipe: bounded requests, streaming token bytes, no HTTP dependency
+ * in the inference engine. The Python frontend owns HTTP and UTF-8 decoding. */
+static volatile sig_atomic_t fr_cancel;
+static void fr_cancel_request(int sig){(void)sig;fr_cancel=1;}
+static bool fr_frame(char kind,const void *data,uint32_t bytes){
+    uint8_t h[5];h[0]=kind;pw_put32(h+1,bytes);
+    return fwrite(h,1,5,stdout)==5&&(!bytes||fwrite(data,1,bytes,stdout)==bytes)&&fflush(stdout)==0;
+}
+static bool fr_error(const char *message){return fr_frame('E',message,(uint32_t)strlen(message));}
+static float fr_float(const uint8_t *p){uint32_t bits=pw_u32(p);float f;memcpy(&f,&bits,4);return f;}
+static bool fr_reset(ds4_qwen4_gpu_graph *g){
+    g->pos=0;
+    for(unsigned il=0;il<FR_L;il++)if(g->layer_lin_state[il]){
+        if(!ds4_gpu_tensor_fill_f32(g->layer_lin_state[il],0,48*128*128)||
+           !ds4_gpu_tensor_fill_f32(g->layer_lin_hist[il],0,3*10240))return false;
+    }
+    /* KV beyond pos is never read; each new prompt overwrites its prefix. */
+    return true;
+}
+static void fr_chat(ds4_qwen4_gpu_graph *g,const ds4_model *m,const ds4_weights *w,
+                    const ds4_vocab *vocab,int fd,uint64_t *seq){
+    struct sigaction action={0};action.sa_handler=fr_cancel_request;action.sa_flags=SA_RESTART;
+    sigemptyset(&action.sa_mask);fr_check(sigaction(SIGUSR1,&action,NULL)==0,"cancel handler");
+    float *logits=xmalloc(DS4_N_VOCAB*4);ds4_engine engine={0};engine.vocab=*vocab;
+    char ready[160];snprintf(ready,sizeof(ready),"{\"context\":%u,\"max_tokens\":16384,\"native\":true}",g->ctx_cap);
+    fr_check(fr_frame('R',ready,(uint32_t)strlen(ready)),"chat ready pipe");
+    uint8_t h[40];
+    while(fread(h,1,sizeof(h),stdin)==sizeof(h)){
+        fr_cancel=0;
+        uint32_t bytes=pw_u32(h+8),limit=pw_u32(h+12),topk=pw_u32(h+28);
+        uint64_t rng=pw_u64(h+16);if(!rng)rng=1;
+        float temp=fr_float(h+24),topp=fr_float(h+32),minp=fr_float(h+36);
+        fr_check(pw_u32(h)==0x48435246u&&pw_u32(h+4)==1&&bytes>0&&bytes<=1048576,"chat frame bounds");
+        char *text=xmalloc((size_t)bytes+1);
+        fr_check(fread(text,1,bytes,stdin)==bytes,"chat request body");text[bytes]=0;
+        if(memchr(text,0,bytes)||!limit||limit>16384||!isfinite(temp)||temp<0||temp>2||
+           topk>200||!isfinite(topp)||topp<=0||topp>1||!isfinite(minp)||minp<0||minp>1){
+            free(text);if(!fr_error("Invalid chat request parameters"))break;continue;
+        }
+        token_vec prompt={0};tokenize_rendered_chat_vocab(vocab,text,&prompt);free(text);
+        if(prompt.len<=0||(uint64_t)prompt.len+limit>g->ctx_cap){
+            char why[192];snprintf(why,sizeof(why),"La conversazione (%d token) e la risposta richiesta (%u) superano il contesto di %u. Apri una nuova chat; nulla è stato tagliato.",prompt.len,limit,g->ctx_cap);
+            free(prompt.v);if(!fr_error(why))break;continue;
+        }
+        fr_check(fr_reset(g),"chat state reset");memset(&fr_time,0,sizeof(fr_time));
+        double started=now_sec();bool ok=true;
+        for(unsigned i=0;ok&&!fr_cancel&&i<(unsigned)prompt.len;i+=FR_T){
+            unsigned T=(unsigned)prompt.len-i<FR_T?(unsigned)prompt.len-i:FR_T;
+            ok=fr_forward(g,m,w,prompt.v+i,T,i+T==(unsigned)prompt.len?logits:NULL,fd,seq);
+            if(ok){char progress[96];snprintf(progress,sizeof(progress),"{\"prefill_tokens\":%u,\"prompt_tokens\":%d}",i+T,prompt.len);
+                ok=fr_frame('P',progress,(uint32_t)strlen(progress));}
+        }
+        double prefill=now_sec()-started;unsigned input=(unsigned)prompt.len,emitted=0;
+        free(prompt.v);memset(&fr_time,0,sizeof(fr_time));started=now_sec();const char *reason="length";
+        for(unsigned n=0;ok&&!fr_cancel&&n<limit;n++){
+            int token=sample_top_p_min_p(logits,DS4_N_VOCAB,temp,(int)topk,topp,minp,&rng,NULL);
+            if(vocab_token_is_generation_stop(vocab,token)){reason="stop";break;}
+            size_t len;char *piece=ds4_token_text(&engine,token,&len);
+            ok=fr_frame('T',piece,(uint32_t)len);free(piece);emitted++;
+            if(ok&&n+1<limit&&!fr_cancel)ok=fr_forward(g,m,w,&token,1,logits,fd,seq);
+        }
+        double seconds=now_sec()-started;
+        if(!ok){fr_error("Inference failed: check the node connection and memory guards");break;}
+        if(fr_cancel)reason="cancelled";
+        char done[512];snprintf(done,sizeof(done),"{\"finish_reason\":\"%s\",\"prompt_tokens\":%u,\"completion_tokens\":%u,\"decode_evaluations\":%u,\"prefill_seconds\":%.6f,\"decode_seconds\":%.6f,\"decode_tok_s\":%.6f}",
+            reason,input,emitted,fr_time.calls,prefill,seconds,seconds>0?fr_time.calls/seconds:0);
+        fprintf(stderr,"FR_CHAT %s\n",done);
+        if(!fr_frame('D',done,(uint32_t)strlen(done)))break;
+    }
+    free(logits);
+}
diff --git a/fronkensteen/oracle.inc b/fronkensteen/oracle.inc
new file mode 100644
index 0000000..46a900a
--- /dev/null
+++ b/fronkensteen/oracle.inc
@@ -0,0 +1,46 @@
+/* Independent scalar dequantization + double-accumulating CPU oracle.
+ * Run after the GPU pair exits, so verification never duplicates its residency. */
+static void fr_oracle(const char *path,const char *capture){
+    ds4_model m;ds4_weights w;model_open(&m,path,false,false);fr_shape(&m);fr_validate(&m);fr_bind(&w,&m,false);
+    qwen4_ref_state state;qwen4_ref_state_init(&state,32);
+    float R[FR_E],mixed[FR_E],blk[FR_E],gate[FR_F],up[FR_F];
+    float *actual=xmalloc(DS4_N_VOCAB*4),*ref=xmalloc(DS4_N_VOCAB*4);
+    FILE *f=fopen(capture,"rb");fr_check(f!=NULL,"open captured logits");
+    uint32_t h[2],pos=0;double started=now_sec();
+    while(fread(h,1,8,f)==8){
+        fr_check(h[0]==pos&&pos<3&&h[1]<DS4_N_VOCAB&&fread(actual,4,DS4_N_VOCAB,f)==DS4_N_VOCAB,"captured logit record");
+        state.pos3[pos*3]=state.pos3[pos*3+1]=state.pos3[pos*3+2]=pos;
+        qwen4_ref_row(&m,w.token_embd,h[1],R);
+        for(unsigned il=0;il<FR_L;il++){
+            const ds4_layer_weights *l=&w.layer[il];
+            qwen4_ref_rms(mixed,R,qwen4_ref_f32(&m,l->attn_norm),FR_E,1e-6f);
+            if(ds4_qwen4_layer_is_linear(il))qwen4_ref_linear_gated(&m,l,il,&state,mixed,blk,true);
+            else qwen4_ref_attention(&m,l,il,&state,mixed,pos,blk);
+            for(unsigned i=0;i<FR_E;i++)R[i]+=blk[i];
+            qwen4_ref_rms(mixed,R,qwen4_ref_f32(&m,l->ffn_norm),FR_E,1e-6f);
+            qwen4_ref_matvec(&m,l->ffn_gate,mixed,gate);qwen4_ref_matvec(&m,l->ffn_up,mixed,up);
+            for(unsigned i=0;i<FR_F;i++)gate[i]=silu(gate[i])*up[i];
+            qwen4_ref_matvec(&m,l->ffn_down,gate,blk);
+            for(unsigned i=0;i<FR_E;i++)R[i]+=blk[i];
+            if(il%16==15)fprintf(stderr,"FR_ORACLE token=%u layer=%u seconds=%.3f\n",pos,il,now_sec()-started);
+        }
+        qwen4_ref_rms(mixed,R,qwen4_ref_f32(&m,w.output_norm),FR_E,1e-6f);
+        qwen4_ref_matvec(&m,w.output,mixed,ref);
+        fr_compare("full-model-pair-vs-independent-cpu",actual,ref,DS4_N_VOCAB);pos++;
+    }
+    fr_check(pos>0&&feof(f),"complete oracle capture");fclose(f);free(actual);free(ref);
+}
+
+static void fr_memory_probe(const char *path,unsigned ctx){
+    fr_check(ctx>=1024&&ctx<=32768,"memory context bound");
+    ds4_model m;ds4_weights w;model_open(&m,path,false,false);fr_shape(&m);fr_validate(&m);
+    fr_pack(&m,false,0,-1);fr_bind(&w,&m,false);fr_map(&m);
+    ds4_qwen4_gpu_graph g;fr_alloc(&g,ctx,FR_T,false);
+    for(unsigned il=0;il<FR_L;il++)if(g.layer_k_cache[il]){
+        fr_check(ds4_gpu_tensor_fill_f32(g.layer_k_cache[il],0,(uint64_t)ctx*512)&&
+            ds4_gpu_tensor_fill_f32(g.layer_v_cache[il],0,(uint64_t)ctx*512),"touch entire FP16 KV allocation");
+    }
+    /* Keep the complete allocation alive through several guard samples. */
+    for(unsigned i=0;i<8;i++)usleep(250000);
+    printf("{\"context\":%u,\"kv_bytes_touched\":%llu,\"memory_probe_complete\":true}\n",ctx,(unsigned long long)ctx*65536);
+}
diff --git a/fronkensteen/tp_flags.inc b/fronkensteen/tp_flags.inc
new file mode 100644
index 0000000..437ed31
--- /dev/null
+++ b/fronkensteen/tp_flags.inc
@@ -0,0 +1,84 @@
+/* Optional dense launch/join using DwarfStar's existing checked flag and
+ * bounded poll kernels. The published payload has a dedicated slab slot;
+ * independent local FFN work may be encoded between kick and wait. */
+static uint64_t fr_tp_dense_pending;
+static uint32_t fr_tp_dense_slot;
+static bool fr_tp_dense_used[DS4_TP_POLL_MAX_SLOTS];
+
+uint64_t ds4_gpu_tp_dense_gate_kick(uint32_t layer) {
+    @autoreleasepool {
+        const uint32_t slot = layer * 2u + 1u;
+        if (!g_batch_cb || !g_tp_thread_running || !g_tp_flag_gates ||
+            !g_tp_poll_gates || !g_tp_check_words || g_ssd_streaming_mode ||
+            g_tp_session_batch_mode || !g_tp_vec_bytes ||
+            slot >= DS4_TP_POLL_MAX_SLOTS || fr_tp_dense_pending ||
+            g_tp_seq >= 0x7ffffffeu) return 0;
+        const uint64_t seq = ++g_tp_seq;
+        const uint32_t value = (uint32_t)seq, words = (uint32_t)(g_tp_vec_bytes / 4u);
+        g_tp_poll_status[slot * 2u] = 0xffffffffu;
+        fr_tp_dense_used[slot] = true;
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_dsv4_tp_flag_set_checked");
+        if (!pipeline) return 0;
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(g_batch_cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBuffer:g_tp_slab_buffer offset:g_tp_slab_buffer_off + g_tp_gpu_flags_off + slot * 4u atIndex:0];
+        [enc setBuffer:g_tp_check_buffer offset:slot * 4u atIndex:1];
+        [enc setBytes:&value length:sizeof(value) atIndex:2];
+        [enc setBuffer:g_tp_slab_buffer offset:g_tp_slab_buffer_off + g_tp_out_off + slot * g_tp_vec_bytes atIndex:3];
+        [enc setBytes:&words length:sizeof(words) atIndex:4];
+        [enc setThreadgroupMemoryLength:8 * sizeof(uint32_t) atIndex:0];
+        [enc dispatchThreadgroups:MTLSizeMake(1,1,1) threadsPerThreadgroup:MTLSizeMake(256,1,1)];
+        ds4_gpu_end_compute_encoder(g_batch_cb, enc);
+        ds4_gpu_close_batch_encoder();
+        /* Completion publishes all payload stores. No host wait here. */
+        if (!ds4_gpu_flush_commands()) return 0;
+        pthread_mutex_lock(&g_tp_mutex);
+        if (g_tp_queue_count >= DS4_GPU_TP_QUEUE) {
+            pthread_mutex_unlock(&g_tp_mutex); return 0;
+        }
+        const uint32_t tail = (g_tp_queue_head + g_tp_queue_count) % DS4_GPU_TP_QUEUE;
+        g_tp_queue[tail] = (ds4_gpu_tp_request){.layer=layer, .gate=1, .seq=seq, .poll=1};
+        g_tp_queue_count++;
+        pthread_cond_signal(&g_tp_cond);
+        pthread_mutex_unlock(&g_tp_mutex);
+        fr_tp_dense_pending = seq; fr_tp_dense_slot = slot;
+        if ([g_pending_cbs count] > DS4_TP_POLL_MAX_INFLIGHT)
+            [g_pending_cbs[[g_pending_cbs count] - 1u - DS4_TP_POLL_MAX_INFLIGHT] waitUntilCompleted];
+        return seq;
+    }
+}
+
+int ds4_gpu_tp_dense_gate_wait(uint64_t seq) {
+    @autoreleasepool {
+        if (!g_batch_cb || !seq || seq != fr_tp_dense_pending) return 0;
+        ds4_gpu_close_batch_encoder();
+        id<MTLComputePipelineState> pipeline = ds4_gpu_get_pipeline("kernel_dsv4_tp_poll_release");
+        if (!pipeline) return 0;
+        const uint32_t value = (uint32_t)seq, nlines = DS4_TP_POLL_LINES;
+        id<MTLComputeCommandEncoder> enc = ds4_gpu_compute_encoder(g_batch_cb);
+        [enc setComputePipelineState:pipeline];
+        [enc setBuffer:g_tp_poll_buffer offset:(seq % DS4_TP_POLL_RING) * DS4_TP_POLL_LINES * DS4_TP_POLL_LINE_BYTES atIndex:0];
+        [enc setBytes:&value length:sizeof(value) atIndex:1];
+        [enc setBytes:&nlines length:sizeof(nlines) atIndex:2];
+        [enc setBuffer:g_tp_poll_buffer offset:(NSUInteger)DS4_TP_POLL_LINES * DS4_TP_POLL_LINE_BYTES * DS4_TP_POLL_RING + fr_tp_dense_slot * 2u * sizeof(uint32_t) atIndex:3];
+        [enc dispatchThreadgroups:MTLSizeMake(1,1,1) threadsPerThreadgroup:MTLSizeMake(32,1,1)];
+        ds4_gpu_end_compute_encoder(g_batch_cb, enc);
+        fr_tp_dense_pending = 0;
+        return 1;
+    }
+}
+
+/* Call only AFTER end_commands. Check every used slot, including the final
+ * gate which has no following flag to make the service validate its poll. */
+int ds4_gpu_tp_dense_gate_check(void) {
+    if (fr_tp_dense_pending) return 0;
+    for (uint32_t slot=0; slot<DS4_TP_POLL_MAX_SLOTS; slot++) {
+        if (!fr_tp_dense_used[slot]) continue;
+        if (g_tp_poll_status[slot * 2u] == 0xffffffffu) {
+            fprintf(stderr,"Fronkensteen: dense poll timeout at slot %u\n",slot);
+            g_tp_failed_flag = 1;
+        }
+        fr_tp_dense_used[slot] = false;
+    }
+    return !g_tp_failed_flag;
+}

diff --git a/ds4_qwen35_backend.h b/ds4_qwen35_backend.h
new file mode 100644
index 0000000..84838d1
--- /dev/null
+++ b/ds4_qwen35_backend.h
@@ -0,0 +1,85 @@
+/* Optional Qwen dense backend. This delegates inference to an installed
+ * llama.cpp Metal server; it does not claim native DwarfStar kernel support. */
+#ifndef DS4_QWEN35_BACKEND_H
+#define DS4_QWEN35_BACKEND_H
+static void ds4_qwen35_dispatch(int argc, char **argv) {
+    int selected = 0;
+    for (int i = 1; i + 1 < argc; i++)
+        if (!strcmp(argv[i], "--backend") && !strcmp(argv[i+1], "qwen35-metal")) selected = 1;
+    if (!selected) return;
+    const char *runtime = getenv("DS4_QWEN35_RUNTIME");
+    const char *model = NULL, *ctx = "4096", *tokens = "2048", *threads = "4";
+    const char *port = "8087", *host = "127.0.0.1", *web = NULL;
+    const char *rpc = NULL, *devices = NULL, *split = "2,1", *mode = "tensor";
+    for (int i = 1; i < argc; i++) {
+        const char *arg = argv[i];
+        if (!strcmp(arg, "--help") || !strcmp(arg, "-h")) {
+            puts("DwarfStar Qwen35 Metal adapter (llama.cpp inference)\n"
+                 "Set DS4_QWEN35_RUNTIME to a compatible llama-server executable.\n"
+                 "--model FILE --ctx N --tokens N --threads N --host HOST --port N --web-root DIR\n"
+                 "Light defaults: 4096 context, one request, Metal/Flash Attention, no vision/MTP.");
+            exit(0);
+        }
+        if (i + 1 >= argc) { fprintf(stderr, "Missing value: %s\n", arg); exit(2); }
+        const char *value = argv[++i];
+        if (!strcmp(arg, "--backend")) {
+            if (strcmp(value, "qwen35-metal")) { fputs("Conflicting backend\n", stderr); exit(2); }
+        } else if (!strcmp(arg, "--model") || !strcmp(arg, "-m")) model = value;
+        else if (!strcmp(arg, "--ctx") || !strcmp(arg, "-c")) ctx = value;
+        else if (!strcmp(arg, "--tokens") || !strcmp(arg, "-n")) tokens = value;
+        else if (!strcmp(arg, "--threads") || !strcmp(arg, "-t")) threads = value;
+        else if (!strcmp(arg, "--host")) host = value;
+        else if (!strcmp(arg, "--port")) port = value;
+        else if (!strcmp(arg, "--web-root")) web = value;
+        else if (!strcmp(arg, "--rpc")) rpc = value;
+        else if (!strcmp(arg, "--device")) devices = value;
+        else if (!strcmp(arg, "--tensor-split")) split = value;
+        else if (!strcmp(arg, "--split-mode")) mode = value;
+        else { fprintf(stderr, "Unsupported Qwen35 backend option: %s\n", arg); exit(2); }
+    }
+    if (!model || !runtime || access(runtime, X_OK)) {
+        fputs("Qwen35 backend requires --model and executable DS4_QWEN35_RUNTIME\n", stderr); exit(2);
+    }
+    char *args[80]; int n = 0;
+#define DS4_Q35_ARG(s) args[n++] = (char *)(s)
+    DS4_Q35_ARG(runtime);
+    DS4_Q35_ARG("-m"); DS4_Q35_ARG(model);
+    DS4_Q35_ARG("--alias"); DS4_Q35_ARG("Qwen3.8-27B");
+    DS4_Q35_ARG("--host"); DS4_Q35_ARG(host);
+    DS4_Q35_ARG("--port"); DS4_Q35_ARG(port);
+    DS4_Q35_ARG("--cors-origins"); DS4_Q35_ARG("http://127.0.0.1:8087");
+    DS4_Q35_ARG("-c"); DS4_Q35_ARG(ctx);
+    DS4_Q35_ARG("-n"); DS4_Q35_ARG(tokens);
+    DS4_Q35_ARG("-t"); DS4_Q35_ARG(threads);
+    DS4_Q35_ARG("-ngl"); DS4_Q35_ARG("99");
+    DS4_Q35_ARG("-fa"); DS4_Q35_ARG("on");
+    DS4_Q35_ARG("-np"); DS4_Q35_ARG("1");
+    DS4_Q35_ARG("-b"); DS4_Q35_ARG("128");
+    DS4_Q35_ARG("-ub"); DS4_Q35_ARG("128");
+    DS4_Q35_ARG("--no-mmproj");
+    DS4_Q35_ARG("--spec-type"); DS4_Q35_ARG("none");
+    DS4_Q35_ARG("--temp"); DS4_Q35_ARG("1");
+    DS4_Q35_ARG("--top-p"); DS4_Q35_ARG("0.95");
+    DS4_Q35_ARG("--top-k"); DS4_Q35_ARG("20");
+    DS4_Q35_ARG("--min-p"); DS4_Q35_ARG("0");
+    DS4_Q35_ARG("--repeat-penalty"); DS4_Q35_ARG("1");
+    DS4_Q35_ARG("--chat-template-kwargs"); DS4_Q35_ARG("{\"reasoning_effort\":\"xhigh\"}");
+    DS4_Q35_ARG("--no-webui-mcp-proxy"); DS4_Q35_ARG("--no-agent");
+    if (web) { DS4_Q35_ARG("--path"); DS4_Q35_ARG(web); }
+    if (rpc) {
+        if (strcmp(mode, "tensor") && strcmp(mode, "layer")) {
+            fputs("Distributed backend requires tensor or layer mode\n", stderr); exit(2);
+        }
+        DS4_Q35_ARG("--rpc"); DS4_Q35_ARG(rpc);
+        DS4_Q35_ARG("--split-mode"); DS4_Q35_ARG(mode);
+        DS4_Q35_ARG("--tensor-split"); DS4_Q35_ARG(split);
+        DS4_Q35_ARG("--fit"); DS4_Q35_ARG("off");
+        if (devices) { DS4_Q35_ARG("--device"); DS4_Q35_ARG(devices); }
+    }
+    args[n] = NULL;
+#undef DS4_Q35_ARG
+    fprintf(stderr, "DwarfStar: Qwen35 backend delegates to llama.cpp Metal; lightweight profile\n");
+    execv(runtime, args);
+    perror("Qwen35 backend exec"); exit(2);
+}
+#endif
diff --git a/ds4_qwen4_capture.inc b/ds4_qwen4_capture.inc
new file mode 100644
index 0000000..c72efcc
--- /dev/null
+++ b/ds4_qwen4_capture.inc
@@ -0,0 +1,53 @@
+/* Bounded research diagnostic. No approximation is applied to inference.
+ * Captures four layers, up to 256 real rows each; all such runs are excluded
+ * from throughput. Integers/floats use this supported host's little endian.
+ * The extra fence is intentional and never enabled in production timings. */
+static bool qwen4_capture_activations(ds4_qwen4_gpu_graph *g,
+                                    const ds4_layer_weights *l, uint32_t T) {
+    const char *path = getenv("DS4_QWEN4_CAPTURE_ACTIVATIONS");
+    if (!path || !*path) return true;
+    static bool initialized = false;
+    static uint32_t rows[48] = {0};
+    uint32_t layer = 48;
+    const uint32_t layers[] = {0, 12, 24, 47};
+    for (uint32_t i = 0; i < 4; i++) {
+        char name[64];
+        int n = snprintf(name, sizeof(name), "blk.%u.ffn_gate_exps.weight", layers[i]);
+        if (l->ffn_gate_exps->name.len == (size_t)n &&
+            !memcmp(l->ffn_gate_exps->name.ptr, name, (size_t)n)) layer = layers[i];
+    }
+    if (layer == 48 || rows[layer] == 256) return true;
+    if (!T || T > 32 || DS4_N_EMBD != 2560 || DS4_N_FF_EXP != 640 ||
+        DS4_N_EXPERT_USED != 10) return false;
+    const uint32_t n = T < 256 - rows[layer] ? T : 256 - rows[layer];
+    const uint64_t nx = (uint64_t)n * DS4_N_EMBD;
+    const uint64_t nm = (uint64_t)n * (DS4_N_EXPERT_USED + 1u) * DS4_N_FF_EXP;
+    const uint64_t nk = (uint64_t)n * DS4_N_EXPERT_USED;
+    float *data = malloc((nx + nm + nk) * sizeof(float));
+    int32_t *ids = malloc(nk * sizeof(int32_t));
+    bool ok = data && ids && ds4_gpu_end_commands() &&
+        ds4_gpu_tensor_read(g->mixed, 0, data, nx * sizeof(float)) &&
+        ds4_gpu_tensor_read(g->mid, 0, data + nx, nm * sizeof(float)) &&
+        ds4_gpu_tensor_read(g->weights, 0, data + nx + nm, nk * sizeof(float)) &&
+        ds4_gpu_tensor_read(g->selected, 0, ids, nk * sizeof(int32_t));
+    for (uint64_t i = 0; ok && i < nx + nm + nk; i++) ok = isfinite(data[i]);
+    for (uint64_t i = 0; ok && i < nk; i++) ok = ids[i] >= 0 && ids[i] < 512;
+    FILE *f = ok ? fopen(path, initialized ? "ab" : "wbx") : NULL;
+    if (!f) ok = false;
+    if (ok && !initialized) ok = fwrite("QWACT01\0", 1, 8, f) == 8;
+    const uint32_t h[] = {layer, n, DS4_N_EMBD, DS4_N_FF_EXP, DS4_N_EXPERT_USED, rows[layer]};
+    const uint64_t offsets[] = {l->ffn_gate_exps->abs_offset,
+        l->ffn_up_exps->abs_offset, l->ffn_down_exps->abs_offset};
+    if (ok) ok = fwrite(h, sizeof(h), 1, f) == 1 &&
+        fwrite(offsets, sizeof(offsets), 1, f) == 1 &&
+        fwrite(data, sizeof(float), nx + nm + nk, f) == nx + nm + nk &&
+        fwrite(ids, sizeof(int32_t), nk, f) == nk;
+    if (f && fclose(f)) ok = false;
+    free(ids); free(data);
+    if (!ok) {
+        fprintf(stderr, "ds4: activation diagnostic failed at layer %u\n", layer);
+        return false;
+    }
+    initialized = true; rows[layer] += n;
+    return glm_graph_begin_commands_if_needed();
+}
diff --git a/ds4_qwen4_packed.inc b/ds4_qwen4_packed.inc
new file mode 100644
index 0000000..0a00135
--- /dev/null
+++ b/ds4_qwen4_packed.inc
@@ -0,0 +1,60 @@
+/* Lossless on-disk expert adjacency; cache, kernels and routing are unchanged.
+ * V1 is deliberately restricted to the pinned 48-layer Q4/MXFP4 trunk.
+ * Launchers verify the whole sidecar hash and file identity before use. */
+#define QWEN4_PACKED_STRIDE 2719744ull
+#define QWEN4_PACKED_HEADER 16384ull
+static int g_qwen_packed_fd = -1;
+static uint64_t g_qwen_packed_rows[48][7];
+static bool g_qwen_packed_checked;
+
+static void qwen4_packed_reset(void) {
+    if (g_qwen_packed_fd >= 0) close(g_qwen_packed_fd);
+    g_qwen_packed_fd = -1; g_qwen_packed_checked = false;
+    memset(g_qwen_packed_rows, 0, sizeof(g_qwen_packed_rows));
+}
+
+static int qwen4_packed_binding(const uint64_t go[3], const uint64_t eb[3],
+        uint64_t original_size, uint32_t experts, uint64_t *base) {
+    const char *path = getenv("DS4_QWEN4_PACKED_EXPERTS");
+    if (!path || !*path) return 1;
+    if (!g_qwen_packed_checked) {
+        uint8_t header[QWEN4_PACKED_HEADER]; uint64_t fields[8]; struct stat st, source_st;
+        const uint64_t expected_size = QWEN4_PACKED_HEADER + 48ull*512u*QWEN4_PACKED_STRIDE;
+        int fd = open(path, O_RDONLY);
+        if (fd < 0) return 0;
+        if (fstat(fd, &st) || fstat(g_model_fd, &source_st) || (uint64_t)st.st_size != expected_size ||
+            fcntl(fd, F_NOCACHE, 1) || fcntl(fd, F_RDAHEAD, 0) ||
+            pread(fd, header, sizeof(header), 0) != sizeof(header)) {
+            close(fd); return 0;
+        }
+        memcpy(fields, header+8, sizeof(fields));
+        if (memcmp(header, "QWPK001\n", 8) || fields[0]!=1 || fields[1]!=48 || fields[2]!=512 ||
+            fields[3]!=QWEN4_PACKED_STRIDE || fields[4]!=(uint64_t)source_st.st_size ||
+            fields[5]!=QWEN4_PACKED_HEADER || fields[6]!=expected_size || fields[7]!=0 ||
+            memcmp(header+72, "680944460a8cbe93ba8b6d7b6107213ffb7e22320bd913000e563ca0a0f25a8a",64)) {
+            fprintf(stderr, "ds4: incompatible packed expert header\n"); close(fd); return 0;
+        }
+        memcpy(g_qwen_packed_rows, header+256, sizeof(g_qwen_packed_rows));
+        for (uint32_t i=0;i<48;i++) {
+            const uint64_t *r=g_qwen_packed_rows[i];
+            if (r[3]!=921600 || r[4]!=921600 || r[5]!=870400 ||
+                r[6]!=QWEN4_PACKED_HEADER+(uint64_t)i*512u*QWEN4_PACKED_STRIDE) {
+                close(fd); return 0;
+            }
+            for (uint32_t j=0;j<3;j++) if (r[j]>original_size || 512u*r[j+3]>original_size-r[j]) {
+                close(fd); return 0;
+            }
+        }
+        g_qwen_packed_fd=fd; g_qwen_packed_checked=true;
+        fprintf(stderr, "ds4: lossless packed trunk experts enabled; split reads and native overlap preserved\n");
+    }
+    if (experts!=512 || g_qwen_stream.draft) return 0;
+    for (uint32_t i=0;i<48;i++) {
+        const uint64_t *r=g_qwen_packed_rows[i];
+        if (!memcmp(r,go,3*sizeof(uint64_t)) && !memcmp(r+3,eb,3*sizeof(uint64_t))) {
+            *base=r[6];return 1;
+        }
+    }
+    fprintf(stderr, "ds4: packed experts do not match this layer's original offsets/strides\n");
+    return 0;
+}
diff --git a/ds4_qwen4_prefill.inc b/ds4_qwen4_prefill.inc
new file mode 100644
index 0000000..e7920f2
--- /dev/null
+++ b/ds4_qwen4_prefill.inc
@@ -0,0 +1,110 @@
+/* Layer-major prompt schedule. Arithmetic copied from the pinned native
+ * forward loop; decode keeps its original function. Do not modify either
+ * layer body without full matched-state parity checks. */
+static bool qwen4_graph_prefill_layer(ds4_qwen4_gpu_graph *g, const ds4_model *m,
+        const ds4_weights *w, uint32_t il, uint32_t T, uint32_t pos0) {
+    const uint32_t hc_dim = DS4_N_EMBD * DS4_N_HC;
+    bool ok = true;
+    const ds4_layer_weights *l = &w->layer[il];
+    if (ds4_qwen4_layer_is_ple(il)) {
+        ok = qwen4_gemv(g->ple_key, m, l->ple_key, g->ple_emb, T) &&
+             qwen4_gemv(g->ple_val, m, l->ple_value, g->ple_emb, T) &&
+             ds4_gpu_qwen4_ple_gate_tensor(g->ple_gated, g->ple_normed, g->R, g->ple_key, g->ple_val,
+                                           m->map, m->size, l->ple_norm_key->abs_offset,
+                                           l->ple_norm_query->abs_offset, l->ple_norm_conv->abs_offset,
+                                           T, DS4_N_EMBD, DS4_N_HC, DS4_RMS_EPS) &&
+             ds4_gpu_qwen4_ple_conv_tensor(g->R, g->ple_gated, g->ple_normed, g->ple_hist, m->map, m->size,
+                                           l->ple_conv->abs_offset, l->ple_conv->type, T, hc_dim, DS4_N_PLE_CONV,
+                                           DS4_N_PLE_NGRAM, g->snap_after_first ? g->snap_ple_hist : NULL, 0u,
+                                           g->snap_after_second ? g->snap2_ple_hist : NULL, 1u);
+    }
+    if (ok) ok = qwen4_graph_hc_mix(g, m, l->hc_attn_norm, l->hc_attn_down, l->hc_attn_up, l->hc_attn_inject, T);
+    if (ok) {
+        ok = ds4_qwen4_layer_is_linear(il) ? qwen4_graph_linear(g, m, l, il, T)
+                                           : qwen4_graph_attention(g, m, l, il, pos0, T);
+    }
+    if (ok) {
+        /* GDN and full attention both project into the same E-wide blk
+         * stream before the hyper-connection residual combine. */
+        if (g->dump_prompt_rows) qwen4_graph_dump_last_attn(g, il, T);
+        ok = qwen4_graph_apply_steering_attn(g, il, T);
+    }
+    if (T == 1u && !g->mtp_R && DS4_N_HC == 4u && ds4_gpu_qwen4_decode_fusions_enabled() &&
+        l->hc_ffn_inject->type == DS4_TENSOR_F16) {
+        if (ok) ok = ds4_gpu_qwen4_hc_combine_norm_tensor(g->hc_u, g->blk, g->inj,
+            g->xn, g->inj_alt, g->R, m->map, m->size, l->hc_ffn_norm->abs_offset,
+            l->hc_ffn_inject->abs_offset, l->hc_ffn_inject->type, T, DS4_N_EMBD, DS4_N_HC, DS4_N_HC, DS4_RMS_EPS);
+        if (ok) {
+            /* hc_u is unused by the single-token fused mixer. Both residual
+             * buffers have the same capacity, including for later prefill. */
+            ds4_gpu_tensor *swap = g->R; g->R = g->hc_u; g->hc_u = swap;
+            swap = g->inj; g->inj = g->inj_alt; g->inj_alt = swap;
+            ok = qwen4_gemv(g->lo, m, l->hc_ffn_down, g->xn, T) &&
+                ds4_gpu_qwen4_hc_gate_mix_tensor(g->mixed, g->xn, g->lo, m->map, m->size,
+                    l->hc_ffn_up->abs_offset, l->hc_ffn_up->type, T, DS4_N_EMBD, DS4_N_HC, DS4_N_HC_LOWRANK);
+        }
+    } else {
+        if (ok) ok = ds4_gpu_qwen4_hc_combine_tensor(g->R, g->blk, g->inj, T, DS4_N_EMBD, DS4_N_HC) != 0;
+        if (ok) ok = qwen4_graph_hc_mix(g, m, l->hc_ffn_norm, l->hc_ffn_down, l->hc_ffn_up, l->hc_ffn_inject, T);
+    }
+    if (ok) ok = qwen4_graph_moe(g, m, l, T);   /* the reduce folds the combine in */
+    if (ok && g->dump_prompt_rows)
+        metal_graph_debug_dump_tensor("qwen_router", g->router,
+                                       (uint64_t)T * DS4_N_EXPERT, il, pos0);
+    if (ok && g->dump_prompt_rows) qwen4_graph_dump_last_ffn(g, il, T);
+    if (ok) ok = qwen4_graph_apply_steering_ffn(g, il, T);
+    return ok;
+}
+
+static bool qwen4_graph_prefill_layer_major(ds4_qwen4_gpu_graph *g, const ds4_model *m,
+        const ds4_weights *w, const int *tokens, uint32_t N, float *logits,
+        ds4_session_cancel_fn cancelled, void *cancel_ud,
+        ds4_session_progress_fn progress, void *progress_ud) {
+    if (!g || g->pos || !N || N > 8192u || N > g->ctx_cap ||
+        !g->cap_tokens || g->cap_tokens > 32u || g->snap_after_first || g->vis_span_count) return false;
+    const uint32_t E = DS4_N_EMBD, hc_dim = E * DS4_N_HC;
+    const uint64_t r_bytes = (uint64_t)N * hc_dim * sizeof(float);
+    const uint64_t p_bytes = (uint64_t)N * E * sizeof(float);
+    float *hidden = malloc(r_bytes), *ple = malloc(p_bytes);
+    bool ok = hidden && ple;
+    for (uint32_t i = 0; i < N && ok; i += g->cap_tokens) {
+        if (cancelled && cancelled(cancel_ud)) { ok = false; break; }
+        const uint32_t T = N-i < g->cap_tokens ? N-i : g->cap_tokens;
+        for (uint32_t t=0; t<T; t++)
+            if (tokens[i+t] < 0 || tokens[i+t] >= (int)DS4_N_VOCAB) ok = false;
+        g->pos = i;
+        if (ok) ok = qwen4_graph_stage_inputs(g,m,w,tokens+i,T) &&
+            ds4_gpu_tensor_read(g->R,0,hidden+(uint64_t)i*hc_dim,(uint64_t)T*hc_dim*4u) &&
+            ds4_gpu_tensor_read(g->ple_emb,0,ple+(uint64_t)i*E,(uint64_t)T*E*4u);
+    }
+    const uint32_t layers = DS4_N_LAYER - DS4_N_NEXTN_PREDICT;
+    for (uint32_t il=0; il<layers && ok; il++) {
+        for (uint32_t i=0; i<N && ok; i+=g->cap_tokens) {
+            if (cancelled && cancelled(cancel_ud)) { ok=false; break; }
+            const uint32_t T = N-i < g->cap_tokens ? N-i : g->cap_tokens;
+            g->pos=i;
+            ok = ds4_gpu_tensor_write(g->R,0,hidden+(uint64_t)i*hc_dim,(uint64_t)T*hc_dim*4u) &&
+                (!ds4_qwen4_layer_is_ple(il) ||
+                 ds4_gpu_tensor_write(g->ple_emb,0,ple+(uint64_t)i*E,(uint64_t)T*E*4u)) &&
+                glm_graph_begin_commands_if_needed() && qwen4_graph_prefill_layer(g,m,w,il,T,i);
+            if (!ds4_gpu_end_commands()) ok=false;
+            if (ok) ok=ds4_gpu_tensor_read(g->R,0,hidden+(uint64_t)i*hc_dim,(uint64_t)T*hc_dim*4u);
+        }
+        if (ok && progress) progress(progress_ud,"prefill_layer",il+1,layers);
+    }
+    if (ok) {
+        /* Reuse the exact native last-row head; trunk state is now at N. */
+        const uint32_t last_T = (N-1u)%g->cap_tokens+1u;
+        ds4_gpu_tensor *last=ds4_gpu_tensor_view(g->R,(uint64_t)(last_T-1u)*hc_dim*4u,(uint64_t)hc_dim*4u);
+        ds4_gpu_tensor *saved=g->R;g->R=last;
+        ok=last && glm_graph_begin_commands_if_needed() &&
+            qwen4_graph_hc_mix(g,m,w->output_hc_norm,w->output_hc_down,w->output_hc_up,NULL,1);
+        g->R=saved;ds4_gpu_tensor_free(last);
+        if(ok) ok=qwen4_gemv(g->logits,m,w->output,g->mixed,1);
+        if(!ds4_gpu_end_commands())ok=false;
+        if(ok)ok=ds4_gpu_tensor_read(g->logits,0,logits,(uint64_t)DS4_N_VOCAB*4u);
+    }
+    free(hidden);free(ple);
+    if(ok)g->pos=N;
+    return ok;
+}
diff --git a/ds4_qwen4_stream.inc b/ds4_qwen4_stream.inc
new file mode 100644
index 0000000..6ac3ccf
--- /dev/null
+++ b/ds4_qwen4_stream.inc
@@ -0,0 +1,395 @@
+/* Exact Qwen expert cache for Metal. Included after the native MoE kernels.
+ * Reuses their quantized arithmetic and the existing bounded pread worker pool.
+ * Host slot IDs are a relocation only: selected/mixture weights remain intact. */
+#include "ds4_qwen4_trace_probe.inc"
+#include "ds4_qwen4_packed.inc"
+
+void ds4_gpu_qwen4_stream_reset(void) {
+    if (ds4_gpu_commands_active()) (void)ds4_gpu_end_commands();
+    qwen4_trace_probe_reset();
+    qwen4_packed_reset();
+    for (int j = 0; j < 3; j++) g_qwen_stream.bank[j] = nil;
+    g_qwen_stream.ids = nil;
+    free(g_qwen_stream.tags); free(g_qwen_stream.age);
+    if (g_qwen_stream.history) {
+        free(g_qwen_stream.history->keys);
+        free(g_qwen_stream.history->scores);
+        free(g_qwen_stream.history->adaptation);
+        free(g_qwen_stream.history);
+    }
+    g_qwen_stream = (ds4_qwen_stream_cache){0};
+}
+
+int ds4_gpu_qwen4_stream_configure(uint64_t bytes) {
+    ds4_gpu_qwen4_stream_reset();
+    /* The loader separately checks dense weights + cache + state reserve
+     * against the selected application budget. OS limits remain unchanged. */
+    if (bytes < 1048576u || bytes > 13ull * 1073741824u) return 0;
+    g_qwen_stream.budget = bytes;
+    g_qwen_stream.overlap_down = ds4_gpu_env_bool("DS4_QWEN4_OVERLAP_DOWN") > 0;
+    g_qwen_stream.overlap_hits = ds4_gpu_env_bool("DS4_QWEN4_OVERLAP_HITS") > 0;
+    const char *policy = getenv("DS4_QWEN4_CACHE_POLICY");
+    if (policy && strcmp(policy, "lru") && strcmp(policy, "ema8") && strcmp(policy, "ema8_decode") &&
+        strcmp(policy, "ema8_verify") && strcmp(policy, "entropy_deficit_decode") && strcmp(policy, "jsd_shift_decode")) {
+        ds4_gpu_qwen4_stream_reset();
+        fprintf(stderr, "ds4: unknown Qwen cache policy\n");
+        return 0;
+    }
+    g_qwen_stream.frequency_cache = policy && strcmp(policy, "lru");
+    g_qwen_stream.frequency_decode_only = policy && strcmp(policy, "lru") && strcmp(policy, "ema8");
+    g_qwen_stream.frequency_verify = policy && !strcmp(policy, "ema8_verify");
+    g_qwen_stream.adaptation_policy = policy && !strcmp(policy, "entropy_deficit_decode") ? 1u :
+        policy && !strcmp(policy, "jsd_shift_decode") ? 2u : 0u;
+    return 1;
+}
+
+int ds4_gpu_qwen4_stream_enabled(void) { return g_qwen_stream.budget != 0; }
+
+void ds4_gpu_qwen4_stream_stats(ds4_qwen4_stream_stats *out) {
+    if (out) *out = g_qwen_stream.stats;
+}
+
+void ds4_gpu_qwen4_adaptation_stats(ds4_qwen4_adaptation_stats *out) {
+    if (out) *out = g_qwen_stream.adaptation_stats;
+}
+
+void ds4_gpu_qwen4_stream_draft(bool active) { g_qwen_stream.draft = active; }
+void ds4_gpu_qwen4_stream_verify_begin(uint32_t rows) {
+    g_qwen_stream.verify_rows = rows >= 2 && rows <= 3 ? rows : 0;
+    memset(g_qwen_stream.verify_mask_bytes, 0, sizeof(g_qwen_stream.verify_mask_bytes));
+}
+void ds4_gpu_qwen4_stream_verify_end(uint32_t committed) {
+    const uint32_t rows = g_qwen_stream.verify_rows;
+    if (rows && committed <= rows) {
+        const uint32_t accepted_mask = (1u << committed) - 1u;
+        for (uint32_t mask = 1; mask < (1u << rows); mask++)
+            if (!(mask & accepted_mask))
+                g_qwen_stream.stats.rejected_only_read_bytes += g_qwen_stream.verify_mask_bytes[mask];
+    }
+    g_qwen_stream.verify_rows = 0;
+}
+
+int ds4_gpu_qwen4_stream_moe_tensor(
+        ds4_gpu_tensor *mid, ds4_gpu_tensor *part, const ds4_gpu_tensor *x,
+        const ds4_gpu_tensor *selected, const void *map, uint64_t size,
+        uint64_t gate, uint64_t up, uint64_t down, uint32_t mid_type, uint32_t down_type,
+        uint32_t experts, uint32_t T, uint32_t K, uint32_t E, uint32_t F,
+        uint64_t sh_gate, uint64_t sh_up, uint64_t sh_down, uint32_t sh_type) {
+    const double begin = ds4_gpu_now_ms();
+    if (!g_qwen_stream.budget || !map || g_model_fd < 0 ||
+        !experts || experts > 512 || !T || T > 32 || !K || K > experts ||
+        !E || !F || K > 32) return 0;
+    const uint64_t go[3] = {gate, up, down};
+    const uint64_t shared[3] = {sh_gate,sh_up,sh_down};
+    const uint32_t shape[7] = {mid_type,down_type,sh_type,experts,K,E,F};
+    if (g_qwen_trace_probe.mode) {
+        if (T!=1 || g_qwen_stream.draft) return 0;
+        if (g_qwen_trace_probe.mode==2)
+            return qwen4_trace_replay(mid,part,x,selected,map,size,go,shared,shape);
+    }
+    const uint32_t down_dim = down_type == 10u ? (F + 255u) / 256u * 256u : F;
+    const uint64_t eb[3] = {
+        (uint64_t)qwen4_expert_row_bytes(mid_type, E) * F,
+        (uint64_t)qwen4_expert_row_bytes(mid_type, E) * F,
+        (uint64_t)qwen4_expert_row_bytes(down_type, down_dim) * E};
+    uint64_t sum = 0;
+    for (int j = 0; j < 3; j++) {
+        if (!eb[j] || go[j] > size || eb[j] > (size - go[j]) / experts) return 0;
+        sum += eb[j];
+    }
+    uint64_t packed_base = 0;
+    if (!qwen4_packed_binding(go, eb, size, experts, &packed_base)) return 0;
+    const uint64_t cap64 = g_qwen_stream.budget / sum;
+    if (!cap64 || cap64 > UINT32_MAX || cap64 < K) return 0;
+    const uint32_t cap = (uint32_t)cap64;
+    /* All representations in a run must have uniform byte strides. Mixed
+     * precision needs separate size classes, never an unchecked reinterpret. */
+    if (g_qwen_stream.cap && (g_qwen_stream.map != map || g_qwen_stream.cap != cap ||
+        memcmp(g_qwen_stream.expert_bytes, eb, sizeof(eb)))) {
+        fprintf(stderr, "ds4: Qwen streaming cache representation changed; reset required\n");
+        return 0;
+    }
+    if (ds4_gpu_commands_active() && !ds4_gpu_end_commands()) return 0; /* router completion and safe slot reuse */
+    const double synced = ds4_gpu_now_ms();
+    if (!g_qwen_stream.cap) {
+        if (fcntl(g_model_fd, F_NOCACHE, 1) || fcntl(g_model_fd, F_RDAHEAD, 0)) {
+            fprintf(stderr, "ds4: cannot configure explicit Qwen expert reads: %s\n", strerror(errno));
+            return 0;
+        }
+        g_qwen_stream.tags = calloc(cap, sizeof(uint64_t));
+        g_qwen_stream.age = calloc(cap, sizeof(uint64_t));
+        if (!g_qwen_stream.tags || !g_qwen_stream.age) return 0;
+        if (g_qwen_stream.frequency_cache) {
+            ds4_qwen_stream_history *h = calloc(1, sizeof(*h));
+            g_qwen_stream.history = h;
+            if (!h) return 0;
+            h->keys = malloc(cap * sizeof(*h->keys));
+            h->scores = malloc(cap * sizeof(*h->scores));
+            if (!h->keys || !h->scores) return 0;
+            if (g_qwen_stream.adaptation_policy) {
+                h->adaptation = calloc(1, sizeof(*h->adaptation));
+                if (!h->adaptation) return 0;
+            }
+            for (uint32_t s = 0; s < cap; s++) h->keys[s] = -1;
+        }
+        for (int j = 0; j < 3; j++) {
+            g_qwen_stream.bank[j] = [g_device newBufferWithLength:cap * eb[j]
+                                                  options:MTLResourceStorageModeShared];
+            if (!g_qwen_stream.bank[j]) return 0;
+        }
+        g_qwen_stream.ids = [g_device newBufferWithLength:32u * 32u * sizeof(int32_t)
+                                               options:MTLResourceStorageModeShared];
+        if (!g_qwen_stream.ids) return 0;
+        g_qwen_stream.cap = cap;
+        g_qwen_stream.map = map;
+        memcpy(g_qwen_stream.expert_bytes, eb, sizeof(eb));
+        g_qwen_stream.stats.allocated_bytes = cap * sum + 32u * 32u * sizeof(int32_t) +
+                                             2u * cap * sizeof(uint64_t);
+        if (g_qwen_stream.history)
+            g_qwen_stream.stats.allocated_bytes += sizeof(ds4_qwen_stream_history) +
+                cap * (sizeof(int32_t) + sizeof(float));
+        if (g_qwen_stream.history && g_qwen_stream.history->adaptation)
+            g_qwen_stream.stats.allocated_bytes += sizeof(ds4_qwen_stream_adaptation);
+    }
+    int32_t truth[32u * 32u], slot_for[512];
+    bool used[512] = {0};
+    uint32_t row_mask[512] = {0};
+    if (!ds4_gpu_tensor_read(selected, 0, truth, (uint64_t)T * K * sizeof(int32_t))) return 0;
+    uint32_t unique = 0;
+    for (uint32_t t = 0; t < T; t++) {
+        bool row[512] = {0};
+        for (uint32_t k = 0; k < K; k++) {
+            const int32_t e = truth[t * K + k];
+            if (e < 0 || (uint32_t)e >= experts || row[e]) return 0;
+            row[e] = true;
+            row_mask[e] |= 1u << t;
+            if (!used[e]) { used[e] = true; unique++; }
+        }
+    }
+    if (unique > cap) return 0;
+    /* Causal probability of selection, with an eight-token half-life. Update
+     * from every authoritative row (including prefill), never guessed routes.
+     * Metadata has no authority over which expert is actually executed. */
+    ds4_qwen_stream_history *h = g_qwen_stream.history;
+    /* Batched prefill revisits the current layer many times. Keeping a hot
+     * expert from an already completed layer displaces useful current weights.
+     * Learn from all rows, but retain native LRU eviction for T>1 calls. */
+    /* A speculative verification traverses all layers like decode. Keep hot
+     * experts across these blocks; only actual multi-row prefill uses LRU.
+     * verify_rows is scoped by the caller, so block size alone is not a phase. */
+    const bool use_frequency = h && (!g_qwen_stream.frequency_decode_only || T == 1 ||
+        (g_qwen_stream.frequency_verify && g_qwen_stream.verify_rows == T));
+    uint32_t layer = 0;
+    if (h) {
+        while (layer < h->layers && h->gate[layer] != gate) layer++;
+        if (layer == h->layers) {
+            if (layer == 64) return 0;
+            h->gate[layer] = gate; h->layers++;
+            for (uint32_t e = 0; e < 512; e++) h->frequency[layer][e] = (float)K / experts;
+            if (h->adaptation)
+                for (uint32_t e = 0; e < 512; e++)
+                    h->adaptation->slow[layer][e] = h->adaptation->fast[layer][e] = (float)K / experts;
+        }
+        const float decay = 0.9170040432046712f; /* exp2(-1/8) */
+        for (uint32_t t = 0; t < T; t++) {
+            for (uint32_t e = 0; e < experts; e++) h->frequency[layer][e] *= decay;
+            for (uint32_t k = 0; k < K; k++) h->frequency[layer][truth[t*K+k]] += 1.f-decay;
+            if (h->adaptation) {
+                const float slow_decay = 0.9892280131939755f; /* exp2(-1/64) */
+                const float fast_decay = 0.7071067811865475f; /* exp2(-1/2) */
+                for (uint32_t e = 0; e < experts; e++) {
+                    h->adaptation->slow[layer][e] *= slow_decay;
+                    h->adaptation->fast[layer][e] *= fast_decay;
+                }
+                for (uint32_t k = 0; k < K; k++) {
+                    h->adaptation->slow[layer][truth[t*K+k]] += 1.f-slow_decay;
+                    h->adaptation->fast[layer][truth[t*K+k]] += 1.f-fast_decay;
+                }
+            }
+        }
+        if (h->adaptation) {
+            /* Only metadata changes. H/JSD use the current authoritative IDs,
+             * never future routes. Zero-frequency terms have zero contribution. */
+            double sum_short = 0, sum_slow = 0, entropy = 0, js = 0;
+            for (uint32_t e = 0; e < experts; e++) {
+                sum_short += h->frequency[layer][e];
+                sum_slow += h->adaptation->slow[layer][e];
+            }
+            for (uint32_t e = 0; e < experts; e++) {
+                const double p = h->frequency[layer][e] / sum_short;
+                const double q = h->adaptation->slow[layer][e] / sum_slow;
+                const double m = (p+q)*.5;
+                if (p > 0) { entropy -= p*log(p); js += .5*p*log(p/m); }
+                if (q > 0) js += .5*q*log(q/m);
+            }
+            h->adaptation->entropy[layer] = experts > 1 ? (float)(entropy/log((double)experts)) : 0.f;
+            h->adaptation->shifted[layer] = js > .05;
+            if (T == 1) {
+                g_qwen_stream.adaptation_stats.single_row_calls++;
+                g_qwen_stream.adaptation_stats.shifted_calls += h->adaptation->shifted[layer];
+                g_qwen_stream.adaptation_stats.entropy_sum += h->adaptation->entropy[layer];
+                g_qwen_stream.adaptation_stats.js_divergence_sum += js;
+            }
+        }
+        for (uint32_t s = 0; use_frequency && s < cap; s++) {
+            const int32_t key = h->keys[s];
+            h->scores[s] = g_qwen_stream.tags[s] && key >= 0 ?
+                h->frequency[key / 512][key % 512] : -1.f;
+            if (h->adaptation && g_qwen_stream.tags[s] && key >= 0) {
+                const uint32_t l = (uint32_t)key / 512, e = (uint32_t)key % 512;
+                if (g_qwen_stream.adaptation_policy == 1u) {
+                    const float slow = h->adaptation->slow[l][e];
+                    h->scores[s] = fmaxf(0.f, slow + h->adaptation->entropy[l] * (slow-h->frequency[l][e]));
+                } else if (h->adaptation->shifted[l]) {
+                    h->scores[s] = h->adaptation->fast[l][e];
+                }
+            }
+        }
+    }
+    const uint64_t stamp = ++g_qwen_stream.clock;
+    uint32_t hits = 0, misses = 0;
+    for (uint32_t e = 0; e < experts; e++) {
+        slot_for[e] = -1;
+        if (!used[e]) continue;
+        const uint64_t tag = gate + e * eb[0] + 1u;
+        for (uint32_t s = 0; s < cap; s++) {
+            if (g_qwen_stream.tags[s] == tag) {
+                slot_for[e] = (int32_t)s; g_qwen_stream.age[s] = stamp; hits++; break;
+            }
+        }
+    }
+    uint32_t hit_mask = 0;
+    const bool split_hits = g_qwen_stream.overlap_hits && T == 1 && K < 32 &&
+        hits && hits < unique;
+    if (split_hits)
+        for (uint32_t k = 0; k < K; k++)
+            if (slot_for[truth[k]] >= 0) hit_mask |= 1u << k;
+    ds4_gpu_stream_expert_pread_task tasks[512 * 3];
+    uint32_t nt = 0;
+    int32_t missing_expert[512];
+    for (uint32_t e = 0; e < experts; e++) {
+        if (!used[e] || slot_for[e] >= 0) continue;
+        uint32_t victim = UINT32_MAX;
+        for (uint32_t s = 0; s < cap; s++) {
+            if (g_qwen_stream.age[s] == stamp) continue;
+            if (victim == UINT32_MAX ||
+                (use_frequency && h->scores[s] < h->scores[victim]) ||
+                ((!use_frequency || h->scores[s] == h->scores[victim]) &&
+                 g_qwen_stream.age[s] < g_qwen_stream.age[victim])) victim = s;
+        }
+        if (victim == UINT32_MAX) return 0;
+        if (g_qwen_stream.tags[victim]) g_qwen_stream.stats.evictions++;
+        g_qwen_stream.tags[victim] = 0; /* never expose incomplete bytes as a hit */
+        g_qwen_stream.age[victim] = stamp;
+        if (h) h->keys[victim] = (int32_t)(layer * 512 + e);
+        slot_for[e] = (int32_t)victim;
+        missing_expert[misses++] = (int32_t)e;
+        uint64_t packed_role = packed_base + (uint64_t)e * QWEN4_PACKED_STRIDE;
+        for (int j = 0; j < 3; j++) {
+            tasks[nt++] = (ds4_gpu_stream_expert_pread_task){
+                .offset = g_qwen_packed_fd >= 0 ? packed_role : go[j] + e * eb[j], .len = eb[j],
+                .fd_plus_one = g_qwen_packed_fd >= 0 ? g_qwen_packed_fd + 1 : 0,
+                .stage_on_cpu = g_qwen_packed_fd >= 0 && ds4_gpu_env_bool("DS4_QWEN4_PREAD_STAGING") > 0,
+                .dst = (uint8_t *)[g_qwen_stream.bank[j] contents] + victim * eb[j]};
+            packed_role += eb[j];
+        }
+    }
+    int32_t *relocated = [g_qwen_stream.ids contents];
+    for (uint32_t i = 0; i < T * K; i++) relocated[i] = slot_for[truth[i]];
+    DS4MetalTensor *ids = [DS4MetalTensor new];
+    ids.buffer = g_qwen_stream.ids; ids.offset = 0; ids.bytes = T * K * sizeof(int32_t);
+    const ds4_gpu_tensor *id_tensor = (__bridge const ds4_gpu_tensor *)ids;
+    memcpy(g_qwen_stream.offsets, go, sizeof(go));
+    const uint32_t completed_mask = split_hits ? hit_mask | (1u << K) : 0u;
+    if (split_hits) {
+        /* All hit slots are pinned for this entire operation. Native kernels
+         * read only those slots; pread below writes disjoint missing slots.
+         * Rank slots and reduction order stay identical. Shared runs once. */
+        if (!ds4_gpu_begin_commands()) return 0;
+        g_qwen_stream.binding = true;
+        g_qwen_stream.skip_slots = ((1u << K) - 1u) & ~hit_mask;
+        const bool ok = ds4_gpu_qwen4_moe_mid_tensor(mid, x, id_tensor, map, size, gate, up,
+            mid_type, cap, T, K, E, F, sh_gate, sh_up, sh_type) &&
+            ds4_gpu_qwen4_moe_down_tensor(part, mid, id_tensor, map, size, down,
+            down_type, cap, T, K, F, E, sh_down, sh_type) && ds4_gpu_flush_commands();
+        g_qwen_stream.binding = false; g_qwen_stream.skip_slots = 0;
+        if (!ok) return 0;
+        g_qwen_stream.stats.overlapped_hit_calls++;
+        g_qwen_stream.stats.overlapped_hit_experts += hits;
+    }
+    ds4_gpu_stream_expert_pread_task down_tasks[512];
+    uint32_t nd = 0;
+    if (g_qwen_stream.overlap_down && nt) {
+        uint32_t first = 0;
+        for (uint32_t i = 0; i < nt; i++) {
+            if (i % 3u == 2u) down_tasks[nd++] = tasks[i];
+            else tasks[first++] = tasks[i];
+        }
+        nt = first;
+    }
+    if (g_qwen_packed_fd >= 0 && ds4_gpu_env_bool("DS4_QWEN4_VECTOR_GU") > 0 && nt) {
+        if (!g_qwen_stream.overlap_down || nt != 2u*nd) return 0;
+        for (uint32_t i=0;i<nd;i++) {
+            ds4_gpu_stream_expert_pread_task a=tasks[2*i], b=tasks[2*i+1];
+            if (a.stage_on_cpu || b.stage_on_cpu || a.fd_plus_one!=b.fd_plus_one || a.offset+a.len!=b.offset) return 0;
+            a.second_dst=b.dst; a.split_at=a.len; a.len+=b.len; tasks[i]=a;
+        }
+        nt=nd; /* gate/up together, down still overlaps native mid computation */
+    }
+    const double io_begin = ds4_gpu_now_ms();
+    uint64_t read_bytes = 0; double pool_wall_ms = 0, service_ms = 0;
+    int io_ok = !nt || ds4_gpu_stream_expert_pread_tasks(tasks, nt, &read_bytes, &pool_wall_ms);
+    for (uint32_t i = 0; i < nt; i++) service_ms += tasks[i].ms;
+    double io_wall = ds4_gpu_now_ms() - io_begin;
+    bool mid_submitted = false;
+    if (io_ok && nd) {
+        if (!ds4_gpu_commands_active() && !ds4_gpu_begin_commands()) return 0;
+        g_qwen_stream.binding = true;
+        g_qwen_stream.skip_slots = completed_mask;
+        mid_submitted = ds4_gpu_qwen4_moe_mid_tensor(mid, x, id_tensor, map, size, gate, up,
+            mid_type, cap, T, K, E, F, sh_gate, sh_up, sh_type) && ds4_gpu_flush_commands();
+        g_qwen_stream.binding = false; g_qwen_stream.skip_slots = 0;
+        if (!mid_submitted) return 0;
+        /* Only gate/up banks are consumed by the submitted kernel. Missing
+         * down slots have no readers until the ordered down dispatch below.
+         * Current selected slots remain pinned for the whole operation. */
+        uint64_t down_bytes = 0;
+        const double down_begin = ds4_gpu_now_ms();
+        io_ok = ds4_gpu_stream_expert_pread_tasks(down_tasks, nd, &down_bytes, &pool_wall_ms);
+        const double down_wall = ds4_gpu_now_ms() - down_begin;
+        io_wall += down_wall; read_bytes += down_bytes;
+        for (uint32_t i = 0; i < nd; i++) service_ms += down_tasks[i].ms;
+        g_qwen_stream.stats.overlapped_mid_calls++;
+        g_qwen_stream.stats.overlap_down_read_bytes += down_bytes;
+        g_qwen_stream.stats.overlap_down_read_wall_ms += down_wall;
+    }
+    g_qwen_stream.stats.logical_read_bytes += read_bytes;
+    g_qwen_stream.stats.read_ops += nt + nd;
+    g_qwen_stream.stats.io_wall_ms += io_wall;
+    g_qwen_stream.stats.io_service_ms += service_ms;
+    g_qwen_stream.stats.router_wait_ms += synced - begin;
+    if (!io_ok) return 0;
+    if (g_qwen_stream.draft) g_qwen_stream.stats.draft_read_bytes += read_bytes;
+    if (g_qwen_stream.verify_rows == T) {
+        g_qwen_stream.stats.verify_read_bytes += read_bytes;
+        for (uint32_t i = 0; i < misses; i++)
+            g_qwen_stream.verify_mask_bytes[row_mask[missing_expert[i]]] += sum;
+    }
+    for (uint32_t i = 0; i < misses; i++) {
+        const uint32_t e = (uint32_t)missing_expert[i];
+        g_qwen_stream.tags[slot_for[e]] = gate + e * eb[0] + 1u;
+    }
+    g_qwen_stream.stats.hits += hits; g_qwen_stream.stats.misses += misses;
+    g_qwen_stream.stats.calls++;
+    if (g_qwen_trace_probe.mode==1 && !qwen4_trace_record_add(go,shared,shape,truth,relocated)) return 0;
+    if (!ds4_gpu_commands_active() && !ds4_gpu_begin_commands()) return 0;
+    g_qwen_stream.binding = true;
+    g_qwen_stream.skip_slots = completed_mask;
+    const int ok = (mid_submitted || ds4_gpu_qwen4_moe_mid_tensor(mid, x, id_tensor, map, size, gate, up,
+        mid_type, cap, T, K, E, F, sh_gate, sh_up, sh_type)) &&
+        ds4_gpu_qwen4_moe_down_tensor(part, mid, id_tensor, map, size, down,
+        down_type, cap, T, K, F, E, sh_down, sh_type);
+    g_qwen_stream.binding = false; g_qwen_stream.skip_slots = 0;
+    g_qwen_stream.stats.controller_ms += ds4_gpu_now_ms() - synced - io_wall;
+    return ok;
+}
diff --git a/ds4_qwen4_trace_probe.inc b/ds4_qwen4_trace_probe.inc
new file mode 100644
index 0000000..3b9f9b5
--- /dev/null
+++ b/ds4_qwen4_trace_probe.inc
@@ -0,0 +1,111 @@
+/* Explicit diagnostic API only. Reuses actual weights/routes from a single
+ * native forward to test its prepared path, never a generation optimization.
+ * The caller must restore the exact input state, validate routes and logits,
+ * and exclude snapshot/preparation costs only in a labelled diagnostic. */
+typedef struct {
+    uint64_t offsets[3], shared[3], tags[32];
+    uint32_t shape[7]; /* mid/down/shared type, experts,K,E,F */
+    int32_t truth[32], slots[32];
+    ds4_gpu_tensor *ids, *actual;
+} qwen4_trace_record;
+static struct {
+    int mode; /* 0=ordinary,1=record,2=prepared replay */
+    uint32_t count, cursor;
+    qwen4_trace_record records[64];
+} g_qwen_trace_probe;
+
+static void qwen4_trace_probe_reset(void) {
+    for (uint32_t i=0;i<64;i++) {
+        ds4_gpu_tensor_free(g_qwen_trace_probe.records[i].ids);
+        ds4_gpu_tensor_free(g_qwen_trace_probe.records[i].actual);
+    }
+    memset(&g_qwen_trace_probe,0,sizeof(g_qwen_trace_probe));
+}
+
+int ds4_gpu_qwen4_trace_probe_mode(int mode) {
+    if (mode<0 || mode>2 || ds4_gpu_commands_active()) return 0;
+    if (mode==1) {
+        qwen4_trace_probe_reset();
+    } else if (mode==2) {
+        if (!g_qwen_trace_probe.count || !g_qwen_stream.cap) return 0;
+        for (uint32_t i=0;i<g_qwen_trace_probe.count;i++) {
+            const qwen4_trace_record *r=&g_qwen_trace_probe.records[i];
+            for (uint32_t k=0;k<r->shape[4];k++) {
+                if (r->slots[k]<0 || (uint32_t)r->slots[k]>=g_qwen_stream.cap ||
+                    g_qwen_stream.tags[r->slots[k]]!=r->tags[k]) return 0;
+            }
+        }
+    }
+    g_qwen_trace_probe.cursor=0;
+    g_qwen_trace_probe.mode=mode;
+    return 1;
+}
+
+int ds4_gpu_qwen4_trace_probe_validate(int32_t *routes, uint32_t capacity) {
+    if (ds4_gpu_commands_active() || !g_qwen_trace_probe.count) return 0;
+    if (g_qwen_trace_probe.mode==2 && g_qwen_trace_probe.cursor!=g_qwen_trace_probe.count) return 0;
+    uint32_t n=0;
+    for (uint32_t i=0;i<g_qwen_trace_probe.count;i++) {
+        const qwen4_trace_record *r=&g_qwen_trace_probe.records[i];
+        const uint32_t k=r->shape[4];
+        if (g_qwen_trace_probe.mode==2) {
+            int32_t actual[32];
+            if (!ds4_gpu_tensor_read(r->actual,0,actual,k*sizeof(int32_t)) ||
+                memcmp(actual,r->truth,k*sizeof(int32_t))) return 0;
+        }
+        if (routes) {
+            if (n>capacity || k>capacity-n) return 0;
+            memcpy(routes+n,r->truth,k*sizeof(int32_t));
+        }
+        n+=k;
+    }
+    return (int)n;
+}
+
+int ds4_gpu_qwen4_trace_probe_cache(uint64_t *tags,uint64_t *age,uint32_t capacity) {
+    if (ds4_gpu_commands_active() || !g_qwen_stream.cap) return 0;
+    if (!tags && !age) return (int)g_qwen_stream.cap;
+    if (!tags || !age || capacity<g_qwen_stream.cap) return 0;
+    memcpy(tags,g_qwen_stream.tags,g_qwen_stream.cap*sizeof(uint64_t));
+    memcpy(age,g_qwen_stream.age,g_qwen_stream.cap*sizeof(uint64_t));
+    return (int)g_qwen_stream.cap;
+}
+
+static int qwen4_trace_record_add(const uint64_t go[3],const uint64_t shared[3],
+        const uint32_t shape[7],const int32_t *truth,const int32_t *slots) {
+    if (g_qwen_trace_probe.count>=64) return 0;
+    qwen4_trace_record *r=&g_qwen_trace_probe.records[g_qwen_trace_probe.count];
+    const uint32_t k=shape[4];
+    memcpy(r->offsets,go,sizeof(r->offsets));memcpy(r->shared,shared,sizeof(r->shared));
+    memcpy(r->shape,shape,sizeof(r->shape));
+    memcpy(r->truth,truth,k*sizeof(int32_t));memcpy(r->slots,slots,k*sizeof(int32_t));
+    for (uint32_t i=0;i<k;i++) r->tags[i]=g_qwen_stream.tags[slots[i]];
+    r->ids=ds4_gpu_tensor_alloc(k*sizeof(int32_t));
+    r->actual=ds4_gpu_tensor_alloc(k*sizeof(int32_t));
+    if (!r->ids || !r->actual || !ds4_gpu_tensor_write(r->ids,0,slots,k*sizeof(int32_t))) return 0;
+    g_qwen_trace_probe.count++;
+    return 1;
+}
+
+static int qwen4_trace_replay(ds4_gpu_tensor *mid,ds4_gpu_tensor *part,
+        const ds4_gpu_tensor *x,const ds4_gpu_tensor *selected,const void *map,uint64_t size,
+        const uint64_t go[3],const uint64_t shared[3],const uint32_t shape[7]) {
+    if (g_qwen_trace_probe.cursor>=g_qwen_trace_probe.count ||
+        map!=g_qwen_stream.map || !ds4_gpu_commands_active()) return 0;
+    qwen4_trace_record *r=&g_qwen_trace_probe.records[g_qwen_trace_probe.cursor++];
+    if (memcmp(r->offsets,go,sizeof(r->offsets)) || memcmp(r->shared,shared,sizeof(r->shared)) ||
+        memcmp(r->shape,shape,sizeof(r->shape))) return 0;
+    const uint32_t k=shape[4],e=shape[5],f=shape[6];
+    /* Preserve the actual GPU router for mandatory post-forward validation.
+     * This blit remains inside the measured path. No host read or wait here. */
+    if (!ds4_gpu_tensor_copy(r->actual,0,selected,0,k*sizeof(int32_t))) return 0;
+    memcpy(g_qwen_stream.offsets,go,sizeof(g_qwen_stream.offsets));
+    g_qwen_stream.binding=true;
+    const int ok=ds4_gpu_qwen4_moe_mid_tensor(mid,x,r->ids,map,size,go[0],go[1],
+        shape[0],g_qwen_stream.cap,1,k,e,f,shared[0],shared[1],shape[2]) &&
+        ds4_gpu_qwen4_moe_down_tensor(part,mid,r->ids,map,size,go[2],
+        shape[1],g_qwen_stream.cap,1,k,f,e,shared[2],shape[2]);
+    g_qwen_stream.binding=false;
+    g_qwen_stream.stats.calls++;g_qwen_stream.stats.hits+=k;
+    return ok;
+}

+/* fronk: drafts from the context (prompt lookup). When the last 4-5 tokens
+ * (ending with first_token) occurred earlier in this session, the tokens that
+ * followed them there are proposed as a chain of up to 7 drafts and verified
+ * with first_token in one pass: an answer that quotes a document or rewrites
+ * code accepts long stretches, which on fronk costs a few new experts per
+ * token, not a pass per token. A full match commits every row. A partial match
+ * restores the pre-verify state (a complete copy: the unfused kernels used for
+ * more than 3 rows keep no per-row snapshot) and replays the accepted prefix.
+ * After a chain the next cycle drafts from the context again or falls back to
+ * MTP. Rejections at the first draft pause lookup for a while, since each one
+ * costs the verify plus a replay. DS4_QWEN4_LOOKUP=0 disables it. */
+#define QWEN4_LOOKUP_MAX 7
+static int qwen4_lookup_drafts(const ds4_session *s, int first_token, int *drafts, int cap) {
+    const int *v = s->checkpoint.v, len = s->checkpoint.len;
+    if (!v || len < 8 || cap < 2) return 0;
+    /* 5- then 4-token matches: 3 tokens recur in ordinary prose and cost rejected chains */
+    for (int n = 5; n >= 4; n--) {
+        /* pattern: v[len-n+1 .. len-1], first_token */
+        for (int i = len - n; i >= 0; i--) {
+            if (v[i + n - 1] != first_token) continue;
+            int k = 0;
+            while (k < n - 1 && v[i + k] == v[len - n + 1 + k]) k++;
+            if (k < n - 1 || i + n >= len) continue;
+            int L = 0;
+            while (L < cap && i + n + L < len) { drafts[L] = v[i + n + L]; L++; }
+            return L >= 2 ? L : 0;
+        }
+    }
+    return 0;
+}

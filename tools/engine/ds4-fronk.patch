+    g_fronk_poll_buffer = [g_device newBufferWithLength:region + DS4_TP_POLL_RING * 2u * sizeof(uint32_t)
+                                                options:MTLResourceStorageModeShared];
+    if (!g_fronk_poll_buffer || !ds4_gpu_get_pipeline("kernel_dsv4_tp_poll_release")) return 0;

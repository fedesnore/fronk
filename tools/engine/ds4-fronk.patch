diff --git a/tests/test_qwen4_stream.inc b/tests/test_qwen4_stream.inc
new file mode 100644
index 0000000..3b48790
--- /dev/null
+++ b/tests/test_qwen4_stream.inc
@@ -0,0 +1,180 @@
+/* Synthetic native-shape parity, cache replacement and failed-read recovery.
+ * These tests establish implementation fidelity, not model capabilities. */
+#include <unistd.h>
+static void test_qwen_stream(arena_t *a, uint32_t T, uint32_t wt, uint32_t dt) {
+    const uint32_t E = 2560, F = 640, NE = 32, K = 10, NO = K + 1;
+    const uint32_t DF = dt == 10u ? 768u : F;
+    const uint64_t start = a->used;
+    double *tmp;
+    const uint64_t go = arena_tier(a, wt, NE * F, E, &tmp); free(tmp);
+    const uint64_t uo = arena_tier(a, wt, NE * F, E, &tmp); free(tmp);
+    const uint64_t d = arena_tier(a, dt, NE * E, DF, &tmp); free(tmp);
+    const uint64_t sg = arena_q8_0(a, F, E, &tmp, .05f); free(tmp);
+    const uint64_t su = arena_q8_0(a, F, E, &tmp, .05f); free(tmp);
+    const uint64_t sd = arena_q8_0(a, E, F, &tmp, .05f); free(tmp);
+    const uint64_t per = (uo - go + d - uo + sg - d) / NE;
+    FILE *f = tmpfile(); require_ok(f != NULL, "stream backing file");
+    require_ok(fwrite(a->base, 1, a->used, f) == a->used && !fflush(f), "stream exact file bytes");
+    require_ok(ds4_gpu_set_model_fd(fileno(f)), "stream fd");
+    require_ok(ds4_gpu_qwen4_stream_configure((T == 1 ? K : NE) * per), "stream budget");
+    float *x = rand_vec(T * E, 1.f);
+    ds4_gpu_tensor *gx = upload(x, T * E), *sel = upload(NULL, T * K);
+    ds4_gpu_tensor *mid = upload(NULL, T * NO * F), *part = upload(NULL, T * NO * E);
+    float *bm = malloc(T * NO * F * 4u), *bp = malloc(T * NO * E * 4u);
+    float *am = malloc(T * NO * F * 4u), *ap = malloc(T * NO * E * 4u);
+    int32_t ids[32 * 10], after[32 * 10];
+    for (uint32_t step = 0; step < 8; step++) {
+        for (uint32_t t = 0; t < T; t++)
+            for (uint32_t k = 0; k < K; k++) ids[t * K + k] = ((step / 2) * 7 + t * 3 + k) % NE;
+        require_ok(ds4_gpu_tensor_write(sel, 0, ids, T * K * 4u), "stream route write");
+        require_ok(ds4_gpu_begin_commands(), "resident begin");
+        require_ok(ds4_gpu_qwen4_moe_mid_tensor(mid, gx, sel, a->base, a->size,
+            go, uo, wt, NE, T, K, E, F, sg, su, 8), "resident mid");
+        require_ok(ds4_gpu_qwen4_moe_down_tensor(part, mid, sel, a->base, a->size,
+            d, dt, NE, T, K, F, E, sd, 8), "resident down");
+        require_ok(ds4_gpu_end_commands(), "resident complete");
+        require_ok(ds4_gpu_tensor_read(mid, 0, bm, T * NO * F * 4u) &&
+                   ds4_gpu_tensor_read(part, 0, bp, T * NO * E * 4u), "resident read");
+        if (step == 0 && (T == 2 || T == 3)) ds4_gpu_qwen4_stream_verify_begin(T);
+        if (step == 2 && T == 1) ds4_gpu_qwen4_stream_draft(true);
+        require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+            go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8), "stream dispatch");
+        ds4_gpu_qwen4_stream_draft(false);
+        if (step == 0 && (T == 2 || T == 3)) ds4_gpu_qwen4_stream_verify_end(1);
+        require_ok(ds4_gpu_end_commands(), "stream complete");
+        require_ok(ds4_gpu_tensor_read(mid, 0, am, T * NO * F * 4u) &&
+                   ds4_gpu_tensor_read(part, 0, ap, T * NO * E * 4u) &&
+                   ds4_gpu_tensor_read(sel, 0, after, T * K * 4u), "stream read");
+        require_ok(!memcmp(ids, after, T * K * 4u), "authoritative IDs unchanged");
+        require_ok(!memcmp(am, bm, T * NO * F * 4u), "stream mid byte exact");
+        require_ok(!memcmp(ap, bp, T * NO * E * 4u), "stream down byte exact, shared included");
+    }
+    ds4_qwen4_stream_stats st;
+    ds4_gpu_qwen4_stream_stats(&st);
+    const char *policy = getenv("DS4_QWEN4_CACHE_POLICY");
+    const bool adaptive = policy && (!strcmp(policy, "jsd_shift_decode") ||
+                                     !strcmp(policy, "entropy_deficit_decode"));
+    ds4_qwen4_adaptation_stats ast;
+    ds4_gpu_qwen4_adaptation_stats(&ast);
+    require_ok(ast.single_row_calls == (adaptive && T == 1 ? 8u : 0u), "adaptation call accounting");
+    require_ok(ast.shifted_calls <= ast.single_row_calls && ast.entropy_sum >= 0 &&
+               ast.entropy_sum <= ast.single_row_calls+1e-5 && ast.js_divergence_sum >= 0 &&
+               ast.js_divergence_sum <= ast.single_row_calls*.693148,
+               "finite normalized entropy and JSD bounds");
+    require_ok(st.calls == 8 && st.hits && st.misses && (T != 1 || st.evictions), "stream cache transitions");
+    require_ok(st.logical_read_bytes == st.misses * per && st.read_ops == st.misses * 3, "stream byte accounting");
+    if (T == 2 || T == 3) {
+        require_ok(st.verify_read_bytes == (K + 3u * (T-1u)) * per, "verify union read accounting");
+        require_ok(st.rejected_only_read_bytes == 3u * (T-1u) * per, "discarded-only rows exclude shared reads");
+    }
+    if (T == 1) require_ok(st.draft_read_bytes == 7u * per, "draft read accounting");
+    if (T == 1 && getenv("DS4_QWEN4_OVERLAP_HITS") && !strcmp(getenv("DS4_QWEN4_OVERLAP_HITS"), "1"))
+        require_ok(st.overlapped_hit_calls == 3 && st.overlapped_hit_experts == 9,
+                   "split hits exercised with unchanged total reads");
+    printf("QWEN_STREAM_TEST {\"T\":%u,\"mid_type\":%u,\"down_type\":%u,\"calls\":%llu,"
+        "\"hits\":%llu,\"misses\":%llu,\"evictions\":%llu,\"max_abs_error\":0,\"logical_read_bytes\":%llu}\n",
+        T, wt, dt, (unsigned long long)st.calls, (unsigned long long)st.hits,
+        (unsigned long long)st.misses, (unsigned long long)st.evictions, (unsigned long long)st.logical_read_bytes);
+    if (T == 1) {
+        require_ok(ds4_gpu_qwen4_trace_probe_mode(1), "record prepared component");
+        require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+            go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8) && ds4_gpu_end_commands(), "record full component");
+        require_ok(ds4_gpu_qwen4_trace_probe_validate(after, 32) == K && !memcmp(after, ids, K * 4u), "recorded actual routes");
+        require_ok(ds4_gpu_qwen4_trace_probe_mode(2) && ds4_gpu_begin_commands(), "prepared component start");
+        require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+            go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8) && ds4_gpu_end_commands(), "prepared component replay");
+        require_ok(ds4_gpu_qwen4_trace_probe_validate(NULL, 0) == K, "prepared actual routes match");
+        require_ok(ds4_gpu_tensor_read(part, 0, ap, T * NO * E * 4u) &&
+            !memcmp(ap, bp, T * NO * E * 4u), "prepared component byte exact");
+        after[0] = (ids[0] + 1) % NE;
+        require_ok(ds4_gpu_tensor_write(sel, 0, after, K * 4u), "inject actual routing mismatch");
+        require_ok(ds4_gpu_qwen4_trace_probe_mode(2) && ds4_gpu_begin_commands(), "mismatch replay start");
+        require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+            go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8) && ds4_gpu_end_commands(), "diagnostic requires later validation");
+        require_ok(!ds4_gpu_qwen4_trace_probe_validate(NULL, 0), "routing mismatch invalidates replay");
+        require_ok(ds4_gpu_qwen4_trace_probe_mode(0), "disable prepared diagnostic");
+        require_ok(ds4_gpu_tensor_write(sel, 0, ids, K * 4u), "restore actual routing");
+        printf("QWEN_PREPARED_PATH_TEST {\"mid_type\":%u,\"down_type\":%u,\"bit_exact\":true,\"mismatched_route_rejected\":true}\n", wt, dt);
+    }
+    if (getenv("DS4_TEST_QWEN4_STREAM_BENCH") && T == 1 && wt == 12u) {
+        /* Evidence C: synthetic resident MoE at target matrix sizes, same
+         * native kernels, no router/backbone/KV. Not an end-to-end reference. */
+        require_ok(ds4_gpu_qwen4_stream_configure(4ull << 30), "benchmark deployment cache budget");
+        require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+            go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8) && ds4_gpu_end_commands(), "benchmark cache fill");
+        for (int rep = -2; rep < 7; rep++) {
+            for (int order = 0; order < 2; order++) {
+                const int streaming = (rep + order) % 2;
+                const int calls = 50;
+                const double t0 = bench_now();
+                for (int n = 0; n < calls; n++) {
+                    if (streaming) {
+                        require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+                            go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8), "timed warm cache");
+                    } else {
+                        require_ok(ds4_gpu_begin_commands(), "timed resident begin");
+                        require_ok(ds4_gpu_qwen4_moe_mid_tensor(mid, gx, sel, a->base, a->size,
+                            go, uo, wt, NE, T, K, E, F, sg, su, 8), "timed resident mid");
+                        require_ok(ds4_gpu_qwen4_moe_down_tensor(part, mid, sel, a->base, a->size,
+                            d, dt, NE, T, K, F, E, sd, 8), "timed resident down");
+                    }
+                    require_ok(ds4_gpu_end_commands(), "timed MoE completion");
+                }
+                const double elapsed = 1e3 * (bench_now() - t0) / calls;
+                if (rep >= 0) printf("QWEN_STREAM_COMPONENT {\"rep\":%d,\"streaming\":%s,\"calls\":%d,\"ms_per_moe\":%.9f,\"cache_budget_gib\":4}\n",
+                    rep, streaming ? "true" : "false", calls, elapsed);
+            }
+        }
+    }
+    /* Failure may leave partially written slots, which must never become hits. */
+    require_ok(ds4_gpu_qwen4_stream_configure((T == 1 ? K : NE) * per), "reset before failure");
+    FILE *bad = tmpfile(); require_ok(bad != NULL, "empty backing file");
+    require_ok(ds4_gpu_set_model_fd(fileno(bad)), "bad fd set");
+    require_ok(!ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+        go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8), "short reads fail closed");
+    require_ok(fwrite(a->base, 1, d, bad) == d && !fflush(bad), "gate/up-only backing file");
+    require_ok(!ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+        go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8), "down read failure after mid submission");
+    require_ok(ds4_gpu_set_model_fd(fileno(f)), "restore backing fd");
+    require_ok(ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+        go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8), "read failure recovery");
+    require_ok(ds4_gpu_end_commands() && ds4_gpu_tensor_read(part, 0, ap, T * NO * E * 4u), "recovery read");
+    require_ok(!memcmp(ap, bp, T * NO * E * 4u), "recovery byte exact");
+    if (T == 1 && getenv("DS4_QWEN4_OVERLAP_HITS") && !strcmp(getenv("DS4_QWEN4_OVERLAP_HITS"), "1")) {
+        /* Nine valid GPU readers plus one failed incoming slot. Recovery must
+         * not treat incomplete data as a hit or overwrite an in-flight hit. */
+        ids[0] = (ids[K-1] + 1) % NE;
+        require_ok(ds4_gpu_tensor_write(sel, 0, ids, K*4u), "mixed failure route");
+        require_ok(ds4_gpu_begin_commands() &&
+            ds4_gpu_qwen4_moe_mid_tensor(mid, gx, sel, a->base, a->size,
+                go, uo, wt, NE, 1, K, E, F, sg, su, 8) &&
+            ds4_gpu_qwen4_moe_down_tensor(part, mid, sel, a->base, a->size,
+                d, dt, NE, 1, K, F, E, sd, 8) && ds4_gpu_end_commands() &&
+            ds4_gpu_tensor_read(part, 0, bp, NO*E*4u), "mixed failure reference");
+        require_ok(!ftruncate(fileno(bad), 0) && ds4_gpu_set_model_fd(fileno(bad)), "mixed failure fd");
+        ds4_gpu_qwen4_stream_stats(&st);
+        const uint64_t hit_calls = st.overlapped_hit_calls;
+        require_ok(!ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+            go, uo, d, wt, dt, NE, 1, K, E, F, sg, su, sd, 8), "mixed miss fails closed");
+        ds4_gpu_qwen4_stream_stats(&st);
+        require_ok(st.overlapped_hit_calls == hit_calls+1, "hits submitted before failed read");
+        require_ok(ds4_gpu_set_model_fd(fileno(f)) &&
+            ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+                go, uo, d, wt, dt, NE, 1, K, E, F, sg, su, sd, 8) && ds4_gpu_end_commands() &&
+            ds4_gpu_tensor_read(part, 0, ap, NO*E*4u) && !memcmp(ap, bp, NO*E*4u),
+            "mixed in-flight failure recovery exact");
+    }
+    after[0] = NE;
+    require_ok(ds4_gpu_tensor_write(sel, 0, after, T * K * 4u), "invalid id write");
+    require_ok(!ds4_gpu_qwen4_stream_moe_tensor(mid, part, gx, sel, a->base, a->size,
+        go, uo, d, wt, dt, NE, T, K, E, F, sg, su, sd, 8), "invalid ID rejected");
+    ds4_gpu_qwen4_stream_reset(); ds4_gpu_set_model_fd(-1);
+    ds4_gpu_qwen4_adaptation_stats(&ast);
+    require_ok(ast.single_row_calls == 0 && ast.shifted_calls == 0 &&
+               ast.entropy_sum == 0 && ast.js_divergence_sum == 0, "adaptation reset");
+    fclose(bad); fclose(f);
+    ds4_gpu_tensor_free(gx); ds4_gpu_tensor_free(sel);
+    ds4_gpu_tensor_free(mid); ds4_gpu_tensor_free(part);
+    free(x); free(bm); free(bp); free(am); free(ap);
+    a->used = start;
+}

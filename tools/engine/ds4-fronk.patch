+/* fronk pipeline: the GPU signals when a layer's expert inputs are ready and
+ * waits for the expert sum in a new batch, so the CPU never stops the GPU per
+ * layer. Values grow monotonically for the life of the process. */
+static id<MTLSharedEvent> g_fronk_event;
